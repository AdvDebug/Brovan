<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BrovanGUI.ViewModels"
        xmlns:views="using:BrovanGUI.Views"
        x:Class="BrovanGUI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Brovan"
        Icon="/Assets/brovan.ico"
        Width="1180" Height="800" MinWidth="900" MinHeight="600"
        Background="{DynamicResource BgWindow}"
        WindowDecorationsTheme="{StaticResource UntitledDecorations}"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">

    <Window.DataTemplates>
        <DataTemplate DataType="vm:ProfileViewModel">
            <views:ProfilePage />
        </DataTemplate>
        <DataTemplate DataType="vm:SetupViewModel">
            <views:SetupPage />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsPage />
        </DataTemplate>
        <DataTemplate DataType="vm:WelcomeViewModel">
            <views:WelcomePage />
        </DataTemplate>
        <DataTemplate DataType="vm:OnboardingViewModel">
            <views:OnboardingPage />
        </DataTemplate>

        <DataTemplate DataType="vm:CategoryViewModel">
            <StackPanel>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="group" Text="{Binding Heading}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="0,0,2,10" IsVisible="{Binding HasChanges}">
                        <TextBlock Text="{Binding ChangedText}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                        <Button Classes="link" Command="{Binding ResetAllCommand}" VerticalAlignment="Center">
                            <TextBlock Text="Reset all" FontSize="12" Foreground="{DynamicResource AccentText}" />
                        </Button>
                    </StackPanel>
                </Grid>
                <Border Classes="groupcard">
                    <StackPanel>
                        <Button Classes="expander" Classes.open="{Binding IsExpanded}" Command="{Binding ToggleCommand}" IsVisible="{Binding IsCollapsible}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Width="3" HorizontalAlignment="Left" Margin="-18,-10,0,-10" Background="{DynamicResource Accent}" IsVisible="{Binding ShowHeaderBar}" />
                                <TextBlock Text="{Binding ToggleLabel}" FontSize="14" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Summary}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="12,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsExpanded}" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CountText}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                               IsVisible="{Binding !IsExpanded}" />
                                    <Path Classes="icon muted chevron" Width="14" Height="14" Data="{StaticResource IconChevronDown}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <ItemsControl Classes="rows" Classes.open="{Binding IsExpanded}" ItemsSource="{Binding Rows}" IsVisible="{Binding IsExpanded}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:ToggleRow">
            <views:SettingCard Header="{Binding Label}" Description="{Binding Help}" IsChanged="{Binding IsOverridden}" Note="{Binding ApplyNote}" Classes.inactive="{Binding IsInactive}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Classes="iconbtn" Command="{Binding ResetCommand}" IsVisible="{Binding IsOverridden}" ToolTip.Tip="Back to the default">
                        <Path Classes="icon muted" Width="13" Height="13" Data="{StaticResource IconReset}" />
                    </Button>
                    <ToggleSwitch IsChecked="{Binding IsOn}" VerticalAlignment="Center" OnContent="" OffContent="" MinWidth="0" />
                </StackPanel>
            </views:SettingCard>
        </DataTemplate>

        <DataTemplate DataType="vm:ChoiceRow">
            <views:SettingCard Header="{Binding Label}" Description="{Binding Help}" IsChanged="{Binding IsOverridden}" Note="{Binding ApplyNote}" Classes.inactive="{Binding IsInactive}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Classes="iconbtn" Command="{Binding ResetCommand}" IsVisible="{Binding IsOverridden}" ToolTip.Tip="Back to the default">
                        <Path Classes="icon muted" Width="13" Height="13" Data="{StaticResource IconReset}" />
                    </Button>
                    <ComboBox Classes="setting" ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" VerticalAlignment="Center">
                        <ComboBox.Styles>
                            <Style Selector="ComboBoxItem" x:DataType="vm:Choice">
                                <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                            </Style>
                        </ComboBox.Styles>
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="vm:Choice">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </views:SettingCard>
        </DataTemplate>

        <DataTemplate DataType="vm:NumberRow">
            <views:SettingCard Header="{Binding Label}" Description="{Binding Help}" IsChanged="{Binding IsOverridden}" Note="{Binding ApplyNote}" Classes.inactive="{Binding IsInactive}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Classes="iconbtn" Command="{Binding ResetCommand}" IsVisible="{Binding IsOverridden}" ToolTip.Tip="Back to the default">
                        <Path Classes="icon muted" Width="13" Height="13" Data="{StaticResource IconReset}" />
                    </Button>
                    <NumericUpDown Classes="setting" Value="{Binding NumberValue}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                   Increment="{Binding Increment}" FormatString="{Binding FormatString}" VerticalAlignment="Center" />
                </StackPanel>
            </views:SettingCard>
        </DataTemplate>

        <DataTemplate DataType="vm:TextRow">
            <views:SettingCard Header="{Binding Label}" Description="{Binding Help}" IsChanged="{Binding IsOverridden}" Note="{Binding ApplyNote}" Classes.inactive="{Binding IsInactive}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Classes="iconbtn" Command="{Binding ResetCommand}" IsVisible="{Binding IsOverridden}" ToolTip.Tip="Back to the default">
                        <Path Classes="icon muted" Width="13" Height="13" Data="{StaticResource IconReset}" />
                    </Button>
                    <TextBox Classes="setting" Text="{Binding TextValue}" PlaceholderText="Default" VerticalAlignment="Center">
                        <TextBox.InnerRightContent>
                            <Button Classes="iconbtn inner" Command="{Binding BrowseCommand}" IsVisible="{Binding IsPath}" ToolTip.Tip="Browse">
                                <Path Classes="icon muted" Width="15" Height="15" Data="{StaticResource IconFolder}" />
                            </Button>
                        </TextBox.InnerRightContent>
                    </TextBox>
                </StackPanel>
            </views:SettingCard>
        </DataTemplate>

        <DataTemplate DataType="vm:ListRow">
            <views:SettingCard Header="{Binding Label}" Description="{Binding Help}" IsChanged="{Binding IsOverridden}" Note="{Binding ApplyNote}" Classes.inactive="{Binding IsInactive}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Classes="iconbtn" Command="{Binding ResetCommand}" IsVisible="{Binding IsOverridden}" ToolTip.Tip="Back to the default">
                        <Path Classes="icon muted" Width="13" Height="13" Data="{StaticResource IconReset}" />
                    </Button>
                    <TextBox Classes="list" Text="{Binding TextValue}" PlaceholderText="{Binding Placeholder}" VerticalAlignment="Center" />
                </StackPanel>
            </views:SettingCard>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid ColumnDefinitions="Auto,*">
        <Border Grid.ColumnSpan="2" Background="{DynamicResource WelcomeTint}" IsHitTestVisible="False" IsVisible="{Binding IsOnboarding}" />
        <Border Grid.Column="1" Height="360" VerticalAlignment="Top" Background="{DynamicResource PageGlow}"
                IsHitTestVisible="False" IsVisible="{Binding !IsOnboarding}" />
        <Border Grid.ColumnSpan="2" Height="480" VerticalAlignment="Top" Background="{DynamicResource WelcomeGlow}"
                IsHitTestVisible="False" IsVisible="{Binding IsOnboarding}" />

        <Border Grid.Column="0" x:Name="Sidebar" Width="256" IsVisible="{Binding !IsOnboarding}" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="40,Auto,*,Auto">

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="9" Margin="16,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Image Source="/Assets/brovan.ico" Width="20" Height="20" RenderOptions.BitmapInterpolationMode="HighQuality" />
                    <TextBlock Text="Brovan" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="8" Margin="0,14,0,4">
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="18,0,10,0">
                        <TextBlock Classes="group" Text="LIBRARY" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="iconbtn" ToolTip.Tip="{Binding SortTip}" IsVisible="{Binding HasProfiles}">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="Sort by name" Command="{Binding SortByNameCommand}" />
                                    <MenuItem Header="Sort by last launched" Command="{Binding SortByRecentCommand}" />
                                </MenuFlyout>
                            </Button.Flyout>
                            <Path Classes="icon muted" Width="15" Height="15" Data="{StaticResource IconSort}" />
                        </Button>
                        <Button Grid.Column="2" Classes="iconbtn" Command="{Binding AddProfileCommand}" ToolTip.Tip="Add a program (Ctrl+N)">
                            <Path Classes="icon" Data="{StaticResource IconPlus}" />
                        </Button>
                    </Grid>
                    <TextBox x:Name="FilterBox" Classes="filter" Text="{Binding FilterText}" PlaceholderText="Filter (Ctrl+F)" Margin="12,0"
                             IsVisible="{Binding ShowFilter}" KeyDown="FilterKeyDown">
                        <TextBox.InnerLeftContent>
                            <Path Classes="icon muted" Width="13" Height="13" Data="{StaticResource IconSearch}" Margin="10,0,0,0" />
                        </TextBox.InnerLeftContent>
                        <TextBox.InnerRightContent>
                            <Button Classes="iconbtn inner" Command="{Binding ClearFilterCommand}" IsVisible="{Binding HasFilter}" ToolTip.Tip="Clear the filter (Esc)">
                                <Path Classes="icon muted" Width="11" Height="11" Data="{StaticResource IconClose}" />
                            </Button>
                        </TextBox.InnerRightContent>
                    </TextBox>
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="6" Margin="18,10,0,0" IsVisible="{Binding !HasVisibleProfiles}">
                    <TextBlock Text="{Binding EmptyLibraryText}" FontSize="13" Foreground="{DynamicResource TextTertiary}" />
                    <Button Classes="link" Command="{Binding ClearFilterCommand}" IsVisible="{Binding HasFilter}" HorizontalAlignment="Left">
                        <TextBlock Text="Clear filter" FontSize="13" Foreground="{DynamicResource AccentText}" />
                    </Button>
                </StackPanel>

                <ListBox Grid.Row="2" x:Name="ProfileList" ItemsSource="{Binding VisibleProfiles}" SelectedItem="{Binding ListSelection}"
                         Background="Transparent" Margin="8,0">
                    <ListBox.Resources>
                        <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="#00000000" />
                        <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="#00000000" />
                        <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="#00000000" />
                    </ListBox.Resources>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="10,7" />
                            <Setter Property="CornerRadius" Value="6" />
                            <Setter Property="Margin" Value="0,1" />
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource BgHover}" />
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource BgSelected}" />
                        </Style>
                        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource BgSelected}" />
                        </Style>
                        <Style Selector="Border.tile">
                            <Setter Property="Background" Value="{DynamicResource BgTile}" />
                        </Style>
                        <Style Selector="Border.tile.letter">
                            <Setter Property="Background" Value="{DynamicResource TileLetter}" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:ProfileViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Classes="navbar" Margin="-10,0,0,0" HorizontalAlignment="Left"
                                        IsVisible="{Binding $parent[ListBoxItem].IsSelected}" />
                                <Border Classes="tile" Classes.letter="{Binding !HasIcon}" Width="28" Height="28" CornerRadius="7" ClipToBounds="True">
                                    <Panel>
                                        <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasIcon}" />
                                        <Image Source="{Binding Icon}" Width="22" Height="22" IsVisible="{Binding HasIcon}" RenderOptions.BitmapInterpolationMode="HighQuality" />
                                    </Panel>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding Name}" />
                                <Panel Grid.Column="2" Width="20" Margin="6,0,0,0" VerticalAlignment="Center" Background="Transparent" ToolTip.Tip="{Binding SidebarTip}">
                                    <Ellipse Classes="dot" Fill="{DynamicResource Brand}" IsVisible="{Binding IsRunning}" HorizontalAlignment="Center" />
                                    <Ellipse Classes="dot" Fill="{DynamicResource Fail}" IsVisible="{Binding LastRunFailed}" HorizontalAlignment="Center" />
                                    <Path Classes="icon warn" Width="14" Height="14" Data="{StaticResource IconWarning}" IsVisible="{Binding CanLocate}"
                                          HorizontalAlignment="Center" />
                                </Panel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="3" Margin="8,4,8,10" Spacing="2">
                    <Button Classes="nav" Classes.active="{Binding IsSetupPage}" Command="{Binding ShowSetupCommand}">
                        <Panel>
                        <Border Classes="navbar" Margin="-12,0,0,0" HorizontalAlignment="Left" IsVisible="{Binding IsSetupPage}" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Classes="icon" Data="{StaticResource IconWrench}" />
                            <TextBlock Text="Setup" VerticalAlignment="Center" />
                        </StackPanel>
                        </Panel>
                    </Button>
                    <Button Classes="nav" Classes.active="{Binding IsSettingsPage}" Command="{Binding ShowSettingsCommand}">
                        <Panel>
                        <Border Classes="navbar" Margin="-12,0,0,0" HorizontalAlignment="Left" IsVisible="{Binding IsSettingsPage}" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Classes="icon" Data="{StaticResource IconGear}" />
                            <TextBlock Text="Settings" VerticalAlignment="Center" />
                        </StackPanel>
                        </Panel>
                    </Button>
                    <Button Classes="nav" Command="{Binding OpenManualCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Classes="icon" Data="{StaticResource IconBook}" />
                            <TextBlock Text="Manual" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="*,Auto" x:Name="ContentHost">
            <TransitioningContentControl Grid.Row="0" Content="{Binding CurrentPage}">
                <TransitioningContentControl.PageTransition>
                    <CrossFade Duration="0:0:0.12" />
                </TransitioningContentControl.PageTransition>
            </TransitioningContentControl>

            <Border Grid.Row="1" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Background="{DynamicResource BgSidebar}" IsVisible="{Binding ShowOutputBar}"
                    BoxShadow="0 -6 18 0 #33000000">
                <Grid RowDefinitions="Auto,Auto">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="12,0,10,0" Height="38">
                        <Button Classes="iconbtn" Command="{Binding Output.ToggleCommand}" ToolTip.Tip="Show or hide the output (Ctrl+`)">
                            <Panel>
                                <Path Classes="icon" Data="{StaticResource IconChevronUp}" IsVisible="{Binding !Output.IsOpen}" />
                                <Path Classes="icon" Data="{StaticResource IconChevronDown}" IsVisible="{Binding Output.IsOpen}" />
                            </Panel>
                        </Button>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="4,0,0,0">
                            <Path Classes="icon muted" Data="{StaticResource IconTerminal}" Width="14" Height="14" />
                            <TextBlock Text="Output" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" Margin="12,0,0,0" VerticalAlignment="Center">
                            <Ellipse Classes="dot" Width="7" Height="7" Fill="{DynamicResource Fail}" IsVisible="{Binding Output.StatusIsProblem}" />
                            <TextBlock Classes="muted" Classes.failtext="{Binding Output.StatusIsProblem}" Text="{Binding Output.Status}" VerticalAlignment="Center"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="3" Classes="iconbtn" Click="CopyOutputClick" IsEnabled="{Binding Output.HasLines}" ToolTip.Tip="Copy the output (or the selected lines)">
                            <Path Classes="icon muted" Data="{StaticResource IconCopy}" Width="14" Height="14" />
                        </Button>
                        <Button Grid.Column="4" Classes="iconbtn" Command="{Binding Output.ClearCommand}" IsEnabled="{Binding Output.HasLines}" ToolTip.Tip="Clear the output">
                            <Path Classes="icon muted" Data="{StaticResource IconClear}" Width="14" Height="14" />
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1" x:Name="OutputPane" RowDefinitions="*,Auto,Auto" ColumnDefinitions="*,Auto" Height="{Binding Output.Height}" IsVisible="{Binding Output.IsOpen}" Background="{DynamicResource BgOutput}">
                        <views:LogView x:Name="Log" Lines="{Binding Output.Lines}" Margin="4,2,0,0" KeyDown="LogKeyDown"
                                       FontFamily="Cascadia Mono, Consolas, DejaVu Sans Mono, Menlo, monospace" FontSize="12"
                                       Foreground="{DynamicResource TextPrimary}" GoodBrush="{DynamicResource Good}" WarnBrush="{DynamicResource Warn}"
                                       BadBrush="{DynamicResource FailText}" AccentBrush="{DynamicResource TextSecondary}" SelectionBrush="{DynamicResource BgSelected}" />
                        <ScrollBar Grid.Column="1" Orientation="Vertical" Visibility="Auto" Minimum="0" Maximum="{Binding #Log.ScrollMaximum}"
                                   ViewportSize="{Binding #Log.ViewportLines}" Value="{Binding #Log.LineOffset, Mode=TwoWay}"
                                   SmallChange="1" LargeChange="{Binding #Log.ViewportLines}" />
                        <ScrollBar Grid.Row="1" Orientation="Horizontal" Visibility="Auto" Minimum="0" Maximum="{Binding #Log.HorizontalMaximum}"
                                   ViewportSize="{Binding #Log.Bounds.Width}" Value="{Binding #Log.HorizontalOffset, Mode=TwoWay}"
                                   SmallChange="20" LargeChange="200" />
                        <TextBox Grid.Row="2" Grid.ColumnSpan="2" Classes="output" Text="{Binding Output.Input}" KeyDown="InputKeyDown" Margin="12,4,12,10"
                                 PlaceholderText="{Binding InputPlaceholder}" IsEnabled="{Binding CanSendInput}">
                            <TextBox.InnerLeftContent>
                                <TextBlock Classes="mono" Text="&gt;" Foreground="{DynamicResource Accent}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </TextBox.InnerLeftContent>
                        </TextBox>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="1" x:Name="OutputGrip" Height="6" Margin="0,-3,0,0" VerticalAlignment="Top" Background="Transparent"
                    Cursor="SizeNorthSouth" IsVisible="{Binding Output.IsOpen}"
                    PointerPressed="GripPressed" PointerMoved="GripMoved" PointerReleased="GripReleased" PointerCaptureLost="GripCaptureLost" />
        </Grid>

        <Border Grid.ColumnSpan="2" x:Name="CloseOverlay" Background="#99000000" IsVisible="False"
                KeyboardNavigation.TabNavigation="Cycle" KeyDown="CloseOverlayKeyDown">
            <Border Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,20" CornerRadius="8"
                    Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock Text="Stop and close?" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="CloseMessage" Classes="muted" FontSize="13" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button x:Name="CancelCloseButton" Classes="secondary" Content="Keep running" Click="CancelCloseClick" />
                        <Button Classes="danger secondary" Content="Stop and close" Click="ConfirmCloseClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
