<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.help">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>

    <Style Selector="TextBlock.group">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="2,0,0,8" />
    </Style>

    <Style Selector="Border.banner">
        <Setter Property="Background" Value="{DynamicResource WarnBanner}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,10" />
    </Style>

    <Style Selector="Path.icon">
        <Setter Property="Stroke" Value="{DynamicResource TextPrimary}" />
        <Setter Property="StrokeThickness" Value="1.75" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Path.icon.fill">
        <Setter Property="Fill" Value="{DynamicResource TextPrimary}" />
        <Setter Property="StrokeThickness" Value="0" />
    </Style>

    <Style Selector="Path.icon.onaccent">
        <Setter Property="Stroke" Value="White" />
    </Style>

    <Style Selector="Path.icon.fill.onaccent">
        <Setter Property="Fill" Value="White" />
    </Style>

    <Style Selector="Path.icon.muted">
        <Setter Property="Stroke" Value="{DynamicResource TextSecondary}" />
    </Style>

    <Style Selector="Path.icon.good">
        <Setter Property="Stroke" Value="{DynamicResource Good}" />
    </Style>

    <Style Selector="Path.icon.warn">
        <Setter Property="Stroke" Value="{DynamicResource Warn}" />
    </Style>

    <Style Selector="Ellipse.dot">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.nav">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgHover}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

    <Style Selector="Button.nav:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgSelected}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

    <Style Selector="Button.nav.active /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgSelected}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

    <Style Selector="Button.iconbtn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="7" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.iconbtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgHover}" />
    </Style>

    <Style Selector="Button.iconbtn.inner">
        <Setter Property="Padding" Value="5" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="Button.iconbtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgSelected}" />
    </Style>

    <Style Selector="Button.launch">
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Background" Value="#C42B1C" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#D13438" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#A4262C" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.secondary">
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="ComboBox.setting">
        <Setter Property="Width" Value="220" />
    </Style>

    <Style Selector="NumericUpDown.setting">
        <Setter Property="Width" Value="160" />
    </Style>

    <Style Selector="TextBox.setting">
        <Setter Property="Width" Value="280" />
    </Style>

    <Style Selector="TextBox.list">
        <Setter Property="Width" Value="280" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBox.form">
        <Setter Property="Width" Value="360" />
    </Style>

    <Style Selector="TextBox.output">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, DejaVu Sans Mono, Menlo, monospace" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="28" />
    </Style>

</Styles>
