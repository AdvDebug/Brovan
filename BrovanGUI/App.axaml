<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:BrovanGUI.Views"
             xmlns:sys="using:System"
             x:Class="BrovanGUI.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#3B82F6" RegionColor="#F3F3F3" />
                <ColorPaletteResources x:Key="Dark" Accent="#3B82F6" RegionColor="#141414" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://BrovanGUI/Styles/Brovan.axaml" />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BgWindow" Color="#141414" />
                    <SolidColorBrush x:Key="BgSidebar" Color="#191919" />
                    <SolidColorBrush x:Key="BgCard" Color="#1F1F1F" />
                    <SolidColorBrush x:Key="BgHover" Color="#262626" />
                    <SolidColorBrush x:Key="BgSelected" Color="#2D2D2D" />
                    <SolidColorBrush x:Key="BgTile" Color="#2A2A2A" />
                    <SolidColorBrush x:Key="BgOutput" Color="#0E0E0E" />
                    <SolidColorBrush x:Key="BorderSubtle" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="TextPrimary" Color="#F2F2F2" />
                    <SolidColorBrush x:Key="TextSecondary" Color="#9B9B9B" />
                    <SolidColorBrush x:Key="Accent" Color="#3B82F6" />
                    <SolidColorBrush x:Key="Good" Color="#4ADE80" />
                    <SolidColorBrush x:Key="Warn" Color="#FBBF24" />
                    <SolidColorBrush x:Key="Bad" Color="#F87171" />
                    <SolidColorBrush x:Key="WarnBanner" Color="#14FBBF24" />
                    <SolidColorBrush x:Key="AccentSoft" Color="#333B82F6" />
                    <SolidColorBrush x:Key="AccentText" Color="#BFDBFE" />
                    <SolidColorBrush x:Key="AccentBorder" Color="#993B82F6" />
                    <SolidColorBrush x:Key="BgCardActive" Color="#212631" />
                    <SolidColorBrush x:Key="BorderStrong" Color="#333333" />
                    <SolidColorBrush x:Key="BgButton" Color="#262626" />
                    <SolidColorBrush x:Key="GoodSoft" Color="#1F4ADE80" />
                    <SolidColorBrush x:Key="WarnSoft" Color="#33FBBF24" />
                    <SolidColorBrush x:Key="WarnBorder" Color="#59FBBF24" />
                    <SolidColorBrush x:Key="WelcomeTint" Color="Transparent" />
                    <SolidColorBrush x:Key="TileLetter" Color="#333B82F6" />
                    <SolidColorBrush x:Key="Brand" Color="#3DD5DE" />
                    <SolidColorBrush x:Key="Fail" Color="#FB923C" />
                    <SolidColorBrush x:Key="FailText" Color="#FB923C" />
                    <SolidColorBrush x:Key="BrandText" Color="#3DD5DE" />
                    <SolidColorBrush x:Key="WarnText" Color="#FBBF24" />
                    <SolidColorBrush x:Key="FailSoft" Color="#29FB923C" />
                    <SolidColorBrush x:Key="BrandSoft" Color="#243DD5DE" />
                    <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#93C5FD" />
                    <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextTertiary" Color="#7C7C7C" />
                    <SolidColorBrush x:Key="BadSoft" Color="#33F87171" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#4C4C4C" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#4C4C4C" />
                    <SolidColorBrush x:Key="RepeatButtonBackgroundDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#6E6E6E" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#8C8C8C" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#A0A0A0" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#C2C2C2" />
                    <RadialGradientBrush x:Key="PageGlow" Center="35%,0%" GradientOrigin="35%,0%" RadiusX="55%" RadiusY="100%">
                        <GradientStop Color="#1F6D4AF0" Offset="0" />
                        <GradientStop Color="#0A3DD5DE" Offset="0.55" />
                        <GradientStop Color="#003DD5DE" Offset="1" />
                    </RadialGradientBrush>
                    <RadialGradientBrush x:Key="WelcomeGlow" Center="27%,18%" GradientOrigin="27%,18%" RadiusX="34%" RadiusY="80%">
                        <GradientStop Color="#383DD5DE" Offset="0" />
                        <GradientStop Color="#296D4AF0" Offset="0.5" />
                        <GradientStop Color="#006D4AF0" Offset="1" />
                    </RadialGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BgWindow" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="BgSidebar" Color="#E6E8EC" />
                    <SolidColorBrush x:Key="BgCard" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BgHover" Color="#DCDFE5" />
                    <SolidColorBrush x:Key="BgSelected" Color="#D8E3F8" />
                    <SolidColorBrush x:Key="BgTile" Color="#E4E4E4" />
                    <SolidColorBrush x:Key="BgOutput" Color="#FAFAFA" />
                    <SolidColorBrush x:Key="BorderSubtle" Color="#DCDCDC" />
                    <SolidColorBrush x:Key="TextPrimary" Color="#1B1B1B" />
                    <SolidColorBrush x:Key="TextSecondary" Color="#666666" />
                    <SolidColorBrush x:Key="Accent" Color="#2563EB" />
                    <SolidColorBrush x:Key="Good" Color="#16A34A" />
                    <SolidColorBrush x:Key="Warn" Color="#D97706" />
                    <SolidColorBrush x:Key="Bad" Color="#DC2626" />
                    <SolidColorBrush x:Key="WarnBanner" Color="#14D97706" />
                    <SolidColorBrush x:Key="AccentSoft" Color="#1F2563EB" />
                    <SolidColorBrush x:Key="AccentText" Color="#1D4ED8" />
                    <SolidColorBrush x:Key="AccentBorder" Color="#992563EB" />
                    <SolidColorBrush x:Key="BgCardActive" Color="#F2F6FE" />
                    <SolidColorBrush x:Key="BorderStrong" Color="#CDD3DB" />
                    <SolidColorBrush x:Key="BgButton" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="GoodSoft" Color="#2416A34A" />
                    <SolidColorBrush x:Key="WarnSoft" Color="#33D97706" />
                    <SolidColorBrush x:Key="WarnBorder" Color="#66D97706" />
                    <SolidColorBrush x:Key="WelcomeTint" Color="#086D4AF0" />
                    <SolidColorBrush x:Key="TileLetter" Color="#402563EB" />
                    <SolidColorBrush x:Key="Brand" Color="#0E9AA7" />
                    <SolidColorBrush x:Key="Fail" Color="#EA580C" />
                    <SolidColorBrush x:Key="FailText" Color="#C2410C" />
                    <SolidColorBrush x:Key="BrandText" Color="#0E7490" />
                    <SolidColorBrush x:Key="WarnText" Color="#B45309" />
                    <SolidColorBrush x:Key="FailSoft" Color="#1FEA580C" />
                    <SolidColorBrush x:Key="BrandSoft" Color="#1F0E9AA7" />
                    <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#3B82F6" />
                    <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextTertiary" Color="#6B7280" />
                    <SolidColorBrush x:Key="BadSoft" Color="#26DC2626" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#C9CED6" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#AEB4BE" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#C9CED6" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#AEB4BE" />
                    <SolidColorBrush x:Key="RepeatButtonBackgroundDisabled" Color="Transparent" />
                    <RadialGradientBrush x:Key="PageGlow" Center="35%,0%" GradientOrigin="35%,0%" RadiusX="55%" RadiusY="100%">
                        <GradientStop Color="#0D2563EB" Offset="0" />
                        <GradientStop Color="#0A3DD5DE" Offset="0.55" />
                        <GradientStop Color="#003DD5DE" Offset="1" />
                    </RadialGradientBrush>
                    <RadialGradientBrush x:Key="WelcomeGlow" Center="30%,0%" GradientOrigin="30%,0%" RadiusX="70%" RadiusY="100%">
                        <GradientStop Color="#306D4AF0" Offset="0" />
                        <GradientStop Color="#143DD5DE" Offset="0.55" />
                        <GradientStop Color="#003DD5DE" Offset="1" />
                    </RadialGradientBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <ControlTheme x:Key="{x:Type views:SettingCard}" TargetType="views:SettingCard">
                <Setter Property="Background" Value="{DynamicResource BgCard}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="18,12" />
                <Setter Property="MinHeight" Value="62" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}">
                            <Panel>
                                <Border Name="PART_Bar" Width="3" HorizontalAlignment="Left" Margin="-18,-12,0,-12"
                                        Background="{DynamicResource Accent}" IsVisible="False" />
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Panel Name="PART_Status" Width="28" Height="28" Margin="0,0,14,0" VerticalAlignment="Center" IsVisible="False">
                                        <Ellipse Name="PART_StatusFill" />
                                        <Path Name="PART_StatusCheck" Data="{DynamicResource IconCheck}" Width="12" Height="8.3" Stretch="Uniform"
                                              Stroke="{DynamicResource Good}" StrokeThickness="2.5" StrokeLineCap="Round" StrokeJoin="Round"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" />
                                        <TextBlock Name="PART_StatusAlert" Text="!" FontSize="15" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" />
                                    </Panel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,24,0" Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Name="PART_Title" Text="{TemplateBinding Header}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <Border CornerRadius="9" Padding="7,0" VerticalAlignment="Center" BorderThickness="1" BorderBrush="{DynamicResource BorderStrong}"
                                                    Background="Transparent" ToolTip.Tip="Has no effect with the current choice above. It still saves, and applies once that changes."
                                                    IsVisible="{Binding Note, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <TextBlock Text="{TemplateBinding Note}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Name="PART_Description" Text="{TemplateBinding Description}" FontSize="12" LineHeight="17" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                                   IsVisible="{Binding Description, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                    <ContentPresenter Name="PART_Content" Grid.Column="2" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center" />
                                </Grid>
                            </Panel>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:changed /template/ Border#PART_Bar">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
                <Style Selector="^:good /template/ Panel#PART_Status">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
                <Style Selector="^:good /template/ Ellipse#PART_StatusFill">
                    <Setter Property="Fill" Value="{DynamicResource GoodSoft}" />
                </Style>
                <Style Selector="^:good /template/ Path#PART_StatusCheck">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
                <Style Selector="^:warn /template/ Panel#PART_Status">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
                <Style Selector="^:warn /template/ Ellipse#PART_StatusFill">
                    <Setter Property="Fill" Value="{DynamicResource WarnSoft}" />
                </Style>
                <Style Selector="^:warn /template/ TextBlock#PART_StatusAlert">
                    <Setter Property="IsVisible" Value="True" />
                    <Setter Property="Foreground" Value="{DynamicResource Warn}" />
                </Style>
                <Style Selector="^:bad /template/ Panel#PART_Status">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
                <Style Selector="^:bad /template/ Ellipse#PART_StatusFill">
                    <Setter Property="Fill" Value="{DynamicResource BadSoft}" />
                </Style>
                <Style Selector="^:bad /template/ TextBlock#PART_StatusAlert">
                    <Setter Property="IsVisible" Value="True" />
                    <Setter Property="Foreground" Value="{DynamicResource Bad}" />
                </Style>
            </ControlTheme>

            <ControlTheme x:Key="{x:Type views:StepCard}" TargetType="views:StepCard">
                <Setter Property="Background" Value="{DynamicResource BgCard}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="18,16" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Panel Name="PART_BadgePanel" Width="30" Height="30" Margin="0,-5,16,0" VerticalAlignment="Top">
                                    <Ellipse Name="PART_Badge" Fill="{DynamicResource AccentSoft}" />
                                    <TextBlock Name="PART_Number" Text="{TemplateBinding Number}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Path Name="PART_Icon" Data="{TemplateBinding Icon}" Width="14" Height="14" Stretch="Uniform"
                                          Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Path Name="PART_Check" Data="{DynamicResource IconCheck}" Width="13" Height="9" Stretch="Uniform"
                                          Stroke="{DynamicResource Good}" StrokeThickness="2.5" StrokeLineCap="Round" StrokeJoin="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" Opacity="0" RenderTransform="scale(0.6)">
                                        <Path.Transitions>
                                            <Transitions>
                                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
                                                <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                                            </Transitions>
                                        </Path.Transitions>
                                    </Path>
                                    <TextBlock Name="PART_Alert" Text="!" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Warn}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" />
                                </Panel>
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" Margin="0,0,20,0">
                                    <DockPanel>
                                        <TextBlock Name="PART_Header" DockPanel.Dock="Left" Text="{TemplateBinding Header}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                        <Border DockPanel.Dock="Left" CornerRadius="9" Padding="7,0" Margin="8,0,0,0" VerticalAlignment="Center" BorderThickness="1"
                                                BorderBrush="{DynamicResource BorderStrong}"
                                                IsVisible="{Binding Note, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="{TemplateBinding Note}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                        </Border>
                                        <TextBlock Name="PART_Dot" DockPanel.Dock="Left" Text="&#183;" FontSize="13" Margin="8,0" Foreground="{DynamicResource TextTertiary}"
                                                   VerticalAlignment="Center" IsVisible="False" />
                                        <TextBlock Name="PART_Inline" Text="{TemplateBinding Description}" FontSize="13"
                                                   Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsVisible="False" />
                                    </DockPanel>
                                    <TextBlock Name="PART_Description" Text="{TemplateBinding Description}" FontSize="13" LineHeight="19" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                                    <ContentPresenter Content="{TemplateBinding Detail}" Margin="0,6,-20,0"
                                                      IsVisible="{Binding Detail, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                </StackPanel>
                                <ContentPresenter Grid.Column="2" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:current">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBorder}" />
                    <Setter Property="BorderThickness" Value="1.5" />
                    <Setter Property="Background" Value="{DynamicResource BgCardActive}" />
                </Style>
                <Style Selector="^:current /template/ Ellipse#PART_Badge">
                    <Setter Property="Fill" Value="{DynamicResource Accent}" />
                </Style>
                <Style Selector="^:current /template/ TextBlock#PART_Number">
                    <Setter Property="Foreground" Value="White" />
                </Style>
                <Style Selector="^:icon /template/ Path#PART_Icon">
                    <Setter Property="Stroke" Value="{DynamicResource AccentText}" />
                </Style>
                <Style Selector="^:done">
                    <Setter Property="Padding" Value="18,10" />
                </Style>
                <Style Selector="^:done /template/ Panel#PART_BadgePanel">
                    <Setter Property="Margin" Value="0,0,16,0" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style Selector="^:done /template/ TextBlock#PART_Description">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="^:done /template/ TextBlock#PART_Inline">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
                <Style Selector="^:done /template/ TextBlock#PART_Dot">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
                <Style Selector="^:done /template/ ContentPresenter">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="^:problem">
                    <Setter Property="BorderBrush" Value="{DynamicResource WarnBorder}" />
                </Style>
                <Style Selector="^:done /template/ Ellipse#PART_Badge">
                    <Setter Property="Fill" Value="{DynamicResource GoodSoft}" />
                </Style>
                <Style Selector="^:done /template/ TextBlock#PART_Header">
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                    <Setter Property="FontWeight" Value="Medium" />
                    <Setter Property="FontSize" Value="14" />
                </Style>
                <Style Selector="^:problem /template/ Ellipse#PART_Badge">
                    <Setter Property="Fill" Value="{DynamicResource WarnSoft}" />
                </Style>
                <Style Selector="^:done /template/ TextBlock#PART_Number">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="^:problem /template/ TextBlock#PART_Number">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="^:done /template/ Path#PART_Icon">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="^:problem /template/ Path#PART_Icon">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="^:done /template/ Path#PART_Check">
                    <Setter Property="IsVisible" Value="True" />
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="RenderTransform" Value="scale(1)" />
                </Style>
                <Style Selector="^:problem /template/ TextBlock#PART_Alert">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
            </ControlTheme>

            <ControlTheme x:Key="UntitledDecorations" TargetType="WindowDrawnDecorations" BasedOn="{StaticResource {x:Type WindowDrawnDecorations}}">
                <Style Selector="^:has-titlebar /template/ Panel#PART_TitleTextPanel">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="^ /template/ Button#PART_FullScreenButton">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
            </ControlTheme>

            <StreamGeometry x:Key="IconPlus">M12 5v14M5 12h14</StreamGeometry>
            <StreamGeometry x:Key="IconTrash">M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 11v6M14 11v6</StreamGeometry>
            <StreamGeometry x:Key="IconPlay">M6 4l14 8-14 8z</StreamGeometry>
            <StreamGeometry x:Key="IconStop">M6 6h12v12H6z</StreamGeometry>
            <StreamGeometry x:Key="IconWrench">M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z</StreamGeometry>
            <StreamGeometry x:Key="IconGear">M12.22 2h-.44a2 2 0 00-2 2v.18a2 2 0 01-1 1.73l-.43.25a2 2 0 01-2 0l-.15-.08a2 2 0 00-2.73.73l-.22.38a2 2 0 00.73 2.73l.15.1a2 2 0 011 1.72v.51a2 2 0 01-1 1.74l-.15.09a2 2 0 00-.73 2.73l.22.38a2 2 0 002.73.73l.15-.08a2 2 0 012 0l.43.25a2 2 0 011 1.73V20a2 2 0 002 2h.44a2 2 0 002-2v-.18a2 2 0 011-1.73l.43-.25a2 2 0 012 0l.15.08a2 2 0 002.73-.73l.22-.39a2 2 0 00-.73-2.73l-.15-.08a2 2 0 01-1-1.74v-.5a2 2 0 011-1.74l.15-.09a2 2 0 00.73-2.73l-.22-.38a2 2 0 00-2.73-.73l-.15.08a2 2 0 01-2 0l-.43-.25a2 2 0 01-1-1.73V4a2 2 0 00-2-2zM12 15a3 3 0 100-6 3 3 0 000 6z</StreamGeometry>
            <StreamGeometry x:Key="IconBook">M4 19.5A2.5 2.5 0 016.5 17H20M4 19.5A2.5 2.5 0 006.5 22H20V2H6.5A2.5 2.5 0 004 4.5v15z</StreamGeometry>
            <StreamGeometry x:Key="IconFolder">M4 20h16a2 2 0 002-2V8a2 2 0 00-2-2h-7.9a2 2 0 01-1.69-.9L9.6 3.9A2 2 0 007.93 3H4a2 2 0 00-2 2v13c0 1.1.9 2 2 2z</StreamGeometry>
            <StreamGeometry x:Key="IconChevronDown">M6 9l6 6 6-6</StreamGeometry>
            <StreamGeometry x:Key="IconChevronUp">M18 15l-6-6-6 6</StreamGeometry>
            <StreamGeometry x:Key="IconReset">M3 12a9 9 0 109-9 9.75 9.75 0 00-6.74 2.74L3 8M3 3v5h5</StreamGeometry>
            <StreamGeometry x:Key="IconWarning">M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0zM12 9v4M12 17h.01</StreamGeometry>
            <StreamGeometry x:Key="IconDownload">M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3</StreamGeometry>
            <StreamGeometry x:Key="IconTerminal">M4 17l6-6-6-6M12 19h8</StreamGeometry>
            <StreamGeometry x:Key="IconExternal">M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3</StreamGeometry>
            <StreamGeometry x:Key="IconRefresh">M23 4v6h-6M1 20v-6h6M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15</StreamGeometry>
            <StreamGeometry x:Key="IconClear">M12 22a10 10 0 100-20 10 10 0 000 20zM4.93 4.93l14.14 14.14</StreamGeometry>
            <StreamGeometry x:Key="IconSort">M7 4v16M3 8l4-4 4 4M17 20V4M13 16l4 4 4-4</StreamGeometry>
            <StreamGeometry x:Key="IconClose">M18 6L6 18M6 6l12 12</StreamGeometry>
            <StreamGeometry x:Key="IconSearch">M11 19a8 8 0 100-16 8 8 0 000 16zM21 21l-4.35-4.35</StreamGeometry>
