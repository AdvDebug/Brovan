<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Unicorn leaves its translated code with longjmp, which a CET shadow stack turns into a fatal unwind. -->
    <CetCompat>false</CetCompat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Iced" Version="1.21.0" />
    <Compile Include="..\Brovan\Core\Emulation\UnicornBinding\Constants.cs" Link="Readers\UnicornConstants.cs" />
    <Compile Include="..\Brovan\Core\ImageResources.cs" Link="Readers\ImageResources.cs" />
  </ItemGroup>
</Project>
