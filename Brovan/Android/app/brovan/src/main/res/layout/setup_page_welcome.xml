<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/page_column"
        style="@style/SetupColumn">

        <FrameLayout style="@style/SetupArt">
            <ImageView
                style="@style/SetupArtLayer"
                android:src="@drawable/art_graphics"
                app:tint="@color/text_secondary" />

            <ImageView
                android:id="@+id/page_art"
                style="@style/SetupArtLayer"
                android:src="@drawable/art_graphics_anim"
                app:tint="@color/accent" />
        </FrameLayout>

        <TextView
            style="@style/SetupTitle"
            android:text="@string/setup_welcome_title" />

        <TextView
            style="@style/SetupBody"
            android:text="@string/setup_welcome_body" />
    </LinearLayout>
</ScrollView>
