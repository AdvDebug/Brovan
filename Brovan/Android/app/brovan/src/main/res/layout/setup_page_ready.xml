<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/page_column"
        style="@style/SetupColumn">

        <FrameLayout style="@style/SetupArt">
            <ImageView
                style="@style/SetupArtLayer"
                android:src="@drawable/art_ready"
                app:tint="@color/text_secondary" />

            <ImageView
                android:id="@+id/page_art"
                style="@style/SetupArtLayer"
                android:src="@drawable/art_ready_anim"
                app:tint="@color/accent" />
        </FrameLayout>

        <TextView
            android:id="@+id/ready_title"
            style="@style/SetupTitle" />

        <TextView
            android:id="@+id/ready_body"
            style="@style/SetupBody" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ready_windows"
                style="@style/SetupCheck" />

            <TextView
                android:id="@+id/ready_runtimes"
                style="@style/SetupCheck"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/ready_program"
                style="@style/SetupCheck"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/ready_device"
            style="@style/SetupNote"
            android:layout_marginTop="20dp" />
    </LinearLayout>
</ScrollView>
