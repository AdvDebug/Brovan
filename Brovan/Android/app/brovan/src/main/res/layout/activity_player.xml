<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- The surface is a child of the overlay, not a sibling: a ViewGroup hands every further pointer of
         a gesture to whichever child already owns one, so a full-screen sibling overlay swallows every
         touch for as long as a control is held. Inside it, each control and the surface are separate
         touch targets and split motion events keep them independent. -->
    <dev.brovan.input.ControlOverlay
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <dev.brovan.BrovanSurfaceView
            android:id="@+id/surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </dev.brovan.input.ControlOverlay>

    <dev.brovan.app.DebuggerView
        android:id="@+id/debugger"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F00D1117"
        android:orientation="vertical"
        android:visibility="gone" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:alpha="0.85"
        android:contentDescription="@string/nav_open"
        app:fabSize="mini"
        app:srcCompat="@drawable/ic_menu" />
</FrameLayout>
