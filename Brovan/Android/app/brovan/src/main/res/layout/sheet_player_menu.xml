<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
            android:textColor="@color/text_primary" android:textSize="20sp" />
        <TextView style="@style/SettingsSummary" android:text="@string/player_menu_hint" />
        <com.google.android.material.button.MaterialButton android:id="@+id/resume"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/player_resume" />
        <TextView style="@style/SectionLabel" android:text="@string/player_controls" />
        <LinearLayout style="@style/SettingsChoiceRow">
            <TextView style="@style/SettingsChoiceLabel" android:text="@string/player_pointer" />
            <TextView android:id="@+id/pointer" style="@style/SettingsChoiceValue" />
        </LinearLayout>
        <LinearLayout style="@style/SettingsChoiceRow">
            <TextView style="@style/SettingsChoiceLabel" android:text="@string/settings_controls" />
            <TextView android:id="@+id/controls" style="@style/SettingsChoiceValue" />
        </LinearLayout>
        <LinearLayout style="@style/SettingsChoiceRow">
            <TextView style="@style/SettingsChoiceLabel" android:text="@string/player_sensitivity" />
            <TextView android:id="@+id/sensitivity_value" style="@style/SettingsChoiceValue"
                android:drawableEnd="@null" />
        </LinearLayout>
        <com.google.android.material.slider.Slider android:id="@+id/sensitivity"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:stepSize="0.1" android:valueFrom="0.4" android:valueTo="3.0"
            app:labelBehavior="gone" />
        <TextView style="@style/SectionLabel" android:text="@string/player_actions" />
        <com.google.android.material.button.MaterialButton android:id="@+id/windows"
            style="@style/Widget.Brovan.SheetAction" android:text="@string/player_windows"
            app:icon="@drawable/ic_window" />
        <com.google.android.material.button.MaterialButton android:id="@+id/console"
            style="@style/Widget.Brovan.SheetAction" android:text="@string/player_show_console"
            app:icon="@drawable/ic_keyboard"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/escape"
            style="@style/Widget.Brovan.SheetAction" android:text="@string/player_escape"
            app:icon="@drawable/ic_keyboard" />
        <com.google.android.material.button.MaterialButton android:id="@+id/redraw"
            style="@style/Widget.Brovan.SheetAction" android:text="@string/player_redraw"
            app:icon="@drawable/ic_refresh" />
        <com.google.android.material.button.MaterialButton android:id="@+id/debugger"
            style="@style/Widget.Brovan.SheetAction" android:text="@string/player_debugger"
            app:icon="@drawable/ic_files"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/quit"
            style="@style/Widget.Brovan.SheetAction" android:text="@string/player_quit"
            app:icon="@drawable/ic_power"
            android:textColor="@color/log_error" app:iconTint="@color/log_error" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
