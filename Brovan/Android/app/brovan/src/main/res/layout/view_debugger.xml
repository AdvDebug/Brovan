<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <LinearLayout
        android:id="@+id/debug_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/debug_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_chip"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            tools:text="Paused" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/debug_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                tools:text="win32u.dll!NtUserGetMessage+0x14 · 4 threads" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/debug_run"
            style="@style/Widget.Brovan.DebugAction"
            android:text="@string/debug_run"
            app:icon="@drawable/ic_play" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/debug_step"
            style="@style/Widget.Brovan.DebugAction"
            android:text="@string/debug_step"
            app:icon="@drawable/ic_step_into" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/debug_step_over"
            style="@style/Widget.Brovan.DebugAction"
            android:text="@string/debug_step_over"
            app:icon="@drawable/ic_step_over" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/debug_goto"
            style="@style/Widget.Brovan.DebugAction"
            android:text="@string/debug_goto"
            app:icon="@drawable/ic_search" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/debug_program"
            style="@style/Widget.Brovan.DebugAction"
            android:text="@string/debug_program"
            app:icon="@drawable/ic_window" />
    </LinearLayout>

    <View
        android:id="@+id/debug_bar_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/outline" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/debug_code_pane"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/debug_code"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="vertical" />

            <TextView
                android:id="@+id/debug_code_empty"
                style="@style/DebugEmpty"
                tools:text="Pause the program to inspect it." />
        </FrameLayout>

        <View
            android:id="@+id/debug_pane_divider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/outline" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/debug_tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface"
                app:tabGravity="start"
                app:tabIndicatorColor="@color/accent"
                app:tabMode="scrollable"
                app:tabSelectedTextColor="@color/text_primary"
                app:tabTextAppearance="@style/TextAppearance.Brovan.Tab"
                app:tabTextColor="@color/text_secondary" />

            <LinearLayout
                android:id="@+id/debug_memory_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/debug_memory_previous"
                    style="@style/DebugIconButton"
                    android:contentDescription="@string/debug_memory_previous"
                    android:rotation="90"
                    android:src="@drawable/ic_chevron_down" />

                <TextView
                    android:id="@+id/debug_memory_address"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:textColor="@color/accent"
                    android:textSize="12sp" />

                <ImageButton
                    android:id="@+id/debug_memory_next"
                    style="@style/DebugIconButton"
                    android:contentDescription="@string/debug_memory_next"
                    android:rotation="-90"
                    android:src="@drawable/ic_chevron_down" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <ScrollView
                    android:id="@+id/log_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/log"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:padding="12dp"
                        android:textColor="@color/text_primary"
                        android:textIsSelectable="true"
                        android:textSize="11sp" />
                </ScrollView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/debug_rows"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="vertical"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/debug_empty"
                    style="@style/DebugEmpty"
                    tools:text="Pause the program to inspect it." />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/debug_command_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="4dp">

                <EditText
                    android:id="@+id/command"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:autofillHints=""
                    android:background="@android:color/transparent"
                    android:fontFamily="monospace"
                    android:hint="@string/player_command_hint"
                    android:imeOptions="actionSend|flagNoExtractUi"
                    android:inputType="text"
                    android:minHeight="48dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="12sp" />

                <ImageButton
                    android:id="@+id/debug_history"
                    style="@style/DebugIconButton"
                    android:contentDescription="@string/debug_history"
                    android:src="@drawable/ic_history" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/send"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/player_send" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</merge>
