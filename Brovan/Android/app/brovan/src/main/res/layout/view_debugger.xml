<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/debug_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_chip"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            tools:text="Paused" />

        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/debug_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        tools:text="ntdll.dll!LdrInitializeThunk (0x1800A0E02)" />

    <HorizontalScrollView
        android:id="@+id/debug_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_variant"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/debug_run"
                style="@style/Widget.Brovan.DebugButton"
                android:text="@string/debug_run" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/debug_pause"
                style="@style/Widget.Brovan.DebugButton"
                android:text="@string/debug_pause" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/debug_step"
                style="@style/Widget.Brovan.DebugButton"
                android:text="@string/debug_step" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/debug_step_over"
                style="@style/Widget.Brovan.DebugButton"
                android:text="@string/debug_step_over" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/debug_goto"
                style="@style/Widget.Brovan.DebugButton"
                android:text="@string/debug_goto" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/debug_refresh"
                style="@style/Widget.Brovan.DebugButton"
                android:text="@string/debug_refresh" />
        </LinearLayout>
    </HorizontalScrollView>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/debug_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:tabIndicatorColor="@color/accent"
        app:tabMode="scrollable"
        app:tabSelectedTextColor="@color/text_primary"
        app:tabTextAppearance="@style/TextAppearance.Brovan.Tab"
        app:tabTextColor="@color/text_secondary" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/log_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textIsSelectable="true"
                android:textSize="11sp" />
        </ScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/debug_rows"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical"
            android:visibility="gone" />

        <TextView
            android:id="@+id/debug_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Pause the program to inspect it." />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/debug_command_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:padding="8dp">

        <EditText
            android:id="@+id/command"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autofillHints=""
            android:background="@android:color/transparent"
            android:fontFamily="monospace"
            android:hint="@string/player_command_hint"
            android:imeOptions="actionSend"
            android:inputType="text"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/send"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/player_send" />
    </LinearLayout>
</merge>
