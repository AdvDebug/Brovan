<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"
    android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingBottom="24dp">
        <TextView style="@style/SectionLabel.Icons" android:layout_marginTop="16dp" android:text="@string/settings_runtimes" />
        <include layout="@layout/section_runtimes" />
        <TextView style="@style/SectionLabel.Icons" android:text="@string/settings_graphics" />
            <LinearLayout style="@style/SettingsGroupBody">
                <LinearLayout style="@style/SettingsIconRow">
                    <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_row_render" />
                    <LinearLayout style="@style/SettingsIconRowText">
                        <TextView style="@style/SettingsChoiceLabel" android:text="@string/settings_render_scale" />
                        <TextView android:id="@+id/render_scale" style="@style/SettingsChoiceValue" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout style="@style/SettingsIconRow">
                    <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_row_display" />
                    <LinearLayout style="@style/SettingsIconRowText">
                        <TextView style="@style/SettingsChoiceLabel" android:text="@string/settings_display_scale" />
                        <TextView android:id="@+id/display_scale" style="@style/SettingsChoiceValue" />
                        <TextView style="@style/SettingsRowSummary" android:text="@string/settings_display_scale_summary"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        <TextView style="@style/SectionLabel.Icons" android:text="@string/player_controls" />
            <LinearLayout style="@style/SettingsGroupBody">
                <LinearLayout style="@style/SettingsIconRow">
                    <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_row_gamepad" />
                    <LinearLayout style="@style/SettingsIconRowText">
                        <TextView style="@style/SettingsChoiceLabel" android:text="@string/settings_controls" />
                        <TextView android:id="@+id/controls" style="@style/SettingsChoiceValue" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout style="@style/SettingsIconRow">
                    <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_row_touch" />
                    <LinearLayout style="@style/SettingsIconRowText">
                        <TextView style="@style/SettingsChoiceLabel" android:text="@string/settings_pointer" />
                        <TextView android:id="@+id/pointer" style="@style/SettingsChoiceValue" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/edit_controls" style="@style/SettingsSwitchRow">
                    <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_row_layout" />
                    <LinearLayout style="@style/SettingsSwitchText">
                        <TextView style="@style/SettingsRowTitle" android:text="@string/program_control_layout" />
                        <TextView style="@style/SettingsRowSummary" android:text="@string/settings_control_layout_summary" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        <TextView style="@style/SectionLabel.Icons" android:text="@string/settings_advanced" />
            <LinearLayout style="@style/SettingsGroupBody">
                <LinearLayout style="@style/SettingsIconRow">
                    <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_row_network" />
                    <LinearLayout style="@style/SettingsIconRowText">
                        <TextView style="@style/SettingsChoiceLabel" android:text="@string/settings_network" />
                        <TextView android:id="@+id/network" style="@style/SettingsChoiceValue" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout style="@style/SettingsIconRow">
                    <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_row_memory" />
                    <LinearLayout style="@style/SettingsIconRowText">
                        <TextView style="@style/SettingsChoiceLabel" android:text="@string/settings_low_memory" />
                        <TextView android:id="@+id/low_memory" style="@style/SettingsChoiceValue" />
                        <TextView style="@style/SettingsRowSummary" android:text="@string/settings_low_memory_summary"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout style="@style/SettingsSwitchRow">
                    <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_row_bolt" />
                    <LinearLayout style="@style/SettingsSwitchText">
                        <TextView style="@style/SettingsRowTitle" android:text="@string/settings_jit_cache" />
                        <TextView style="@style/SettingsRowSummary" android:text="@string/settings_jit_cache_summary" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/jit_cache"
                        style="@style/SettingsSwitch" android:contentDescription="@string/settings_jit_cache" />
                </LinearLayout>
                <LinearLayout style="@style/SettingsSwitchRow">
                    <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_row_shader" />
                    <LinearLayout style="@style/SettingsSwitchText">
                        <TextView style="@style/SettingsRowTitle" android:text="@string/settings_relax_vulkan" />
                        <TextView style="@style/SettingsRowSummary" android:text="@string/settings_relax_vulkan_summary" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/relax_vulkan"
                        style="@style/SettingsSwitch" android:contentDescription="@string/settings_relax_vulkan" />
                </LinearLayout>
                <LinearLayout style="@style/SettingsSwitchRow">
                    <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_row_speed" />
                    <LinearLayout style="@style/SettingsSwitchText">
                        <TextView style="@style/SettingsRowTitle" android:text="@string/settings_sustained" />
                        <TextView style="@style/SettingsRowSummary" android:text="@string/settings_sustained_summary" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/sustained"
                        style="@style/SettingsSwitch" android:contentDescription="@string/settings_sustained" />
                </LinearLayout>
                <LinearLayout style="@style/SettingsSwitchRow">
                    <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_row_code" />
                    <LinearLayout style="@style/SettingsSwitchText">
                        <TextView style="@style/SettingsRowTitle" android:text="@string/settings_developer" />
                        <TextView style="@style/SettingsRowSummary" android:text="@string/settings_developer_summary" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/developer"
                        style="@style/SettingsSwitch" android:contentDescription="@string/settings_developer" />
                </LinearLayout>
            </LinearLayout>

        <TextView style="@style/SectionLabel.Icons" android:text="@string/settings_app" />
            <LinearLayout style="@style/SettingsGroupBody">
                <LinearLayout android:id="@+id/nav_theme" style="@style/SettingsSwitchRow"
                    android:minHeight="56dp">
                    <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_row_palette" />
                    <LinearLayout style="@style/SettingsSwitchText">
                        <TextView style="@style/SettingsRowTitle" android:text="@string/nav_theme" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/nav_about" style="@style/SettingsSwitchRow"
                    android:minHeight="56dp">
                    <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_row_info" />
                    <LinearLayout style="@style/SettingsSwitchText">
                        <TextView style="@style/SettingsRowTitle" android:text="@string/nav_about" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
    </LinearLayout>
</ScrollView>
