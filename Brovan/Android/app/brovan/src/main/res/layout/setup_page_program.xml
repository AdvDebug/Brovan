<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/page_column"
        style="@style/SetupColumn">

        <FrameLayout style="@style/SetupArt">
            <ImageView
                style="@style/SetupArtLayer"
                android:src="@drawable/art_programs"
                app:tint="@color/text_secondary" />

            <ImageView
                android:id="@+id/page_art"
                style="@style/SetupArtLayer"
                android:src="@drawable/art_programs_anim"
                app:tint="@color/accent" />
        </FrameLayout>

        <TextView
            style="@style/SetupTitle"
            android:text="@string/setup_program_title" />

        <TextView
            android:id="@+id/program_state"
            style="@style/SetupBody" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/program_folder"
            style="@style/SetupAction"
            android:text="@string/library_add_folder" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/program_file"
            style="@style/SetupLink"
            android:text="@string/library_add_file" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/program_progress"
            style="@style/SetupProgress" />
    </LinearLayout>
</ScrollView>
