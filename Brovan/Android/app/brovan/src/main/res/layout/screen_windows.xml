<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <com.google.android.material.card.MaterialCardView style="@style/Widget.Brovan.Card.Group">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView style="@style/RuntimeIcon" android:src="@drawable/ic_windows" />
                    <TextView style="@style/RuntimeTitle" android:text="@string/windows_title" />
                    <TextView android:id="@+id/windows_status" style="@style/StatusChip.Dot" />
                </LinearLayout>
                <TextView style="@style/SettingsSummary" android:layout_marginTop="8dp"
                    android:text="@string/windows_media_hint" />
                <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/windows_progress"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:indeterminate="true" android:visibility="gone" />
                <TextView android:id="@+id/windows_progress_text" style="@style/SettingsSummary"
                    android:layout_marginTop="8dp" android:visibility="gone" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="end|center_vertical">
                    <com.google.android.material.button.MaterialButton android:id="@+id/windows_open_page"
                        style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/windows_open_page" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/windows_choose"
                        style="@style/Widget.Material3.Button.TonalButton" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginStart="8dp"
                        android:text="@string/windows_choose" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/windows_install"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="@string/windows_install" android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView style="@style/Widget.Brovan.Card.Group"
            android:layout_marginTop="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView style="@style/RuntimeIcon" android:src="@drawable/ic_files" />
                    <TextView style="@style/RuntimeTitle" android:text="@string/windows_runtimes_title" />
                    <TextView android:id="@+id/windows_runtimes_status" style="@style/StatusChip.Dot" />
                </LinearLayout>
                <TextView style="@style/SettingsSummary" android:layout_marginTop="8dp"
                    android:text="@string/windows_runtimes_notice" />
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/windows_runtimes_progress"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:indeterminate="true" android:visibility="gone" />
                <TextView android:id="@+id/windows_runtimes_progress_text" style="@style/SettingsSummary"
                    android:layout_marginTop="8dp" android:visibility="gone" />
                <com.google.android.material.button.MaterialButton android:id="@+id/windows_runtimes"
                    style="@style/Widget.Material3.Button.TonalButton" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginTop="12dp"
                    android:text="@string/runtime_install" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView style="@style/Widget.Brovan.Card.Group"
            android:layout_marginTop="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView style="@style/RuntimeIcon" android:src="@drawable/ic_grid" />
                    <TextView style="@style/RuntimeTitle" android:text="@string/settings_dxvk" />
                    <TextView android:id="@+id/dxvk_status" style="@style/StatusChip.Dot" />
                </LinearLayout>
                <TextView style="@style/SettingsSummary" android:layout_marginTop="8dp"
                    android:text="@string/settings_dxvk_summary" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/dxvk_version_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:hint="@string/settings_dxvk_version">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/dxvk_version"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/dxvk_progress"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:indeterminate="true" android:visibility="gone" />
                <TextView android:id="@+id/dxvk_progress_text" style="@style/SettingsSummary"
                    android:layout_marginTop="8dp" android:visibility="gone" />
                <com.google.android.material.button.MaterialButton android:id="@+id/dxvk_install"
                    style="@style/Widget.Material3.Button.TonalButton" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginTop="12dp"
                    android:text="@string/runtime_install" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
