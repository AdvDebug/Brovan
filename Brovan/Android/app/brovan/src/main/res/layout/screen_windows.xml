<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingBottom="24dp">
        <TextView style="@style/SectionLabel" android:text="@string/windows_title" />
        <TextView android:id="@+id/windows_status" style="@style/SettingsRowTitle" android:layout_marginTop="8dp" />
        <TextView style="@style/SettingsSummary" android:text="@string/windows_media_hint" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton android:id="@+id/windows_choose"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp"
                android:paddingStart="8dp" android:paddingEnd="8dp" android:singleLine="false"
                android:text="@string/windows_choose" />
            <com.google.android.material.button.MaterialButton android:id="@+id/windows_open_page"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp"
                android:layout_marginStart="8dp" android:paddingStart="8dp" android:paddingEnd="8dp"
                android:singleLine="false" android:text="@string/windows_open_page" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/windows_install"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/windows_install" />
        <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/windows_progress"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:indeterminate="true" android:visibility="gone" />
        <TextView android:id="@+id/windows_progress_text" style="@style/SettingsSummary" android:visibility="gone" />
        <TextView style="@style/SectionLabel" android:text="@string/windows_runtimes_title" />
        <TextView android:id="@+id/windows_runtimes_status" style="@style/SettingsRowTitle" android:layout_marginTop="8dp" />
        <TextView style="@style/SettingsSummary" android:text="@string/windows_runtimes_notice" />
        <com.google.android.material.button.MaterialButton android:id="@+id/windows_runtimes"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/windows_runtimes" />
        <TextView style="@style/SectionLabel" android:text="@string/settings_dxvk" />
        <TextView android:id="@+id/dxvk_status" style="@style/SettingsRowTitle" android:layout_marginTop="8dp" />
        <TextView style="@style/SettingsSummary" android:text="@string/settings_dxvk_summary" />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/dxvk_version_layout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:hint="@string/settings_dxvk_version">
            <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/dxvk_version"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/dxvk_install"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/settings_dxvk_install" />
        <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/dxvk_progress"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:indeterminate="true" android:visibility="gone" />
        <TextView android:id="@+id/dxvk_progress_text" style="@style/SettingsSummary" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
