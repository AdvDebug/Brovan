    <string name="settings_edit_controls">Edit the on-screen controls</string>
    <string name="settings_edit_controls_summary">Put your own buttons, joysticks and touchpads on the screen. Give a key to each one. When you save, Brovan uses your layout.</string>
    <string name="settings_developer">Developer mode</string>
    <string name="settings_developer_summary">Shows the console and emulator trace while a program runs. Programs run slower.</string>
    <string name="settings_dxvk">Direct3D games</string>
    <string name="settings_dxvk_summary">This phone draws with Vulkan only. DXVK changes Direct3D 8 to 11 into Vulkan. Games that use Direct3D need it. Other programs are not affected.</string>
