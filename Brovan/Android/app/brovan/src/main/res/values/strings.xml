    <string name="setup_welcome_title">Let’s get started</string>
    <string name="setup_welcome_body">Brovan runs real Windows programs on this phone. Four short steps and you are ready to play.</string>
    <string name="setup_welcome_programs">Real Windows programs</string>
    <string name="setup_welcome_programs_body">Games and desktop apps run unmodified, from the folder they shipped in.</string>
    <string name="setup_welcome_graphics">Vulkan graphics</string>
    <string name="setup_welcome_graphics_body">Drawing is handed to the phone’s own GPU driver instead of being emulated.</string>
    <string name="setup_welcome_controls">Touch controls</string>
    <string name="setup_welcome_controls_body">A joystick, D-pad or trackpad stands in for the keyboard and mouse.</string>

    <string name="setup_windows_title">Windows system files</string>
    <string name="setup_windows_body">Brovan runs real Windows programs, so it needs the real system libraries, NLS tables and registry hives. It fetches Windows installation media from Microsoft and extracts only those. Nothing Microsoft ships is bundled with Brovan, so a valid Windows license is required.</string>
    <string name="setup_windows_state_missing">Not installed</string>
    <string name="setup_windows_state_installed">Installed</string>

    <string name="setup_runtimes_title">Visual C++ runtimes</string>
    <string name="setup_runtimes_body">Most games and desktop programs are built with Visual C++ and stop at a missing-DLL error without these. They are not part of Windows, so they are downloaded separately.</string>
    <string name="setup_runtimes_note">Skip this if you only run programs that carry their own libraries.</string>

    <string name="setup_program_title">Your first program</string>
    <string name="setup_program_body">Add the folder holding the program and everything it ships with. Brovan copies it into its own storage and runs it from there, so the program finds its files where it expects them.</string>
    <string name="setup_program_note">You can add more at any time from the library.</string>
    <string name="setup_program_none">Nothing added yet</string>
    <string name="setup_program_count">%1$d in your library</string>

    <string name="setup_ready_title">Ready to play</string>
    <string name="setup_ready_body">Everything Brovan needs is in place. Open your library and press play.</string>
    <string name="setup_almost_title">Almost there</string>
    <string name="setup_almost_body">Brovan works once the steps below are done. Come back any time through Get started in the menu.</string>
