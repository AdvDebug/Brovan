    <string name="settings_title">Settings</string>
    <string name="settings_subtitle">These settings apply to all programs.</string>
    <string name="settings_graphics">Graphics and input</string>
    <string name="settings_advanced">Advanced</string>
    <string name="settings_fit_window">Fit the window to the screen</string>
    <string name="settings_fit_window_summary">Scale the window up to fill the screen. If off, the window keeps its own size.</string>
    <string name="settings_network_summary">How much network access programs get.</string>
    <string name="settings_controls">On-screen controls</string>
    <string name="settings_network">Network access</string>
    <string name="settings_jit_cache">JIT code cache</string>
    <string name="settings_jit_cache_summary">Keeps translated code for the next start, so programs start quicker. Experimental.</string>
    <string name="settings_sustained">Sustained performance</string>
    <string name="settings_sustained_summary">Holds a steady speed on long runs instead of a fast start that slows down as the device gets hot. Peak speed is lower.</string>
    <string name="settings_pointer">Touch behaviour</string>
    <string name="settings_edit_controls">Edit the on-screen controls</string>
    <string name="settings_edit_controls_summary">Put your own buttons, joysticks and touchpads on the screen. Give a key to each one. When you save, Brovan uses your layout.</string>
    <string name="settings_developer">Developer mode</string>
    <string name="settings_developer_summary">Shows the console and emulator trace while a program runs. Programs run slower.</string>
    <string name="settings_dxvk">Direct3D games</string>
    <string name="settings_dxvk_summary">This phone draws with Vulkan only. DXVK changes Direct3D 8 to 11 into Vulkan. Games that use Direct3D need it. Other programs are not affected.</string>
