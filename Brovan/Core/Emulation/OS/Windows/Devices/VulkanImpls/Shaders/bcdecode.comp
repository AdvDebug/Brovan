#ifdef BC_DECODE_BC7

const uint kBc7Subsets[8] = uint[8](3u, 2u, 3u, 2u, 1u, 1u, 1u, 2u);
const uint kBc7PartitionBits[8] = uint[8](4u, 6u, 6u, 6u, 0u, 0u, 0u, 6u);
const uint kBc7RotationBits[8] = uint[8](0u, 0u, 0u, 0u, 2u, 2u, 0u, 0u);
const uint kBc7SelectionBits[8] = uint[8](0u, 0u, 0u, 0u, 1u, 0u, 0u, 0u);
const uint kBc7ColorBits[8] = uint[8](4u, 6u, 5u, 7u, 5u, 7u, 7u, 5u);
const uint kBc7AlphaBits[8] = uint[8](0u, 0u, 0u, 0u, 6u, 8u, 7u, 5u);
const uint kBc7EndpointPBits[8] = uint[8](1u, 0u, 0u, 1u, 0u, 0u, 1u, 1u);
const uint kBc7SharedPBits[8] = uint[8](0u, 1u, 0u, 0u, 0u, 0u, 0u, 0u);
const uint kBc7IndexBits[8] = uint[8](3u, 3u, 2u, 2u, 2u, 2u, 4u, 2u);
const uint kBc7Index2Bits[8] = uint[8](0u, 0u, 0u, 0u, 3u, 2u, 0u, 0u);

uint subsetOf(uint subsets, uint shape, uint pixel)
{
    if (subsets == 1u)
        return 0u;
    if (subsets == 2u)
        return (kPartition2[shape] >> pixel) & 1u;
    return (kPartition3[shape] >> (2u * pixel)) & 3u;
}

uint expand8(uint v, uint n)
{
    return (v << (8u - n)) | (v >> (2u * n - 8u));
}

void decodeBc7(uvec2 origin, uint z, uvec4 block)
{
    uint mode = uint(findLSB(block.x));
    if (block.x == 0u || mode > 7u)
    {
        fill(origin, z, uvec4(0u));
        return;
    }

    uint at = mode + 1u;
    uint subsets = kBc7Subsets[mode];
    uint shape = bits(block, at, kBc7PartitionBits[mode]);
    at += kBc7PartitionBits[mode];
    uint rotation = bits(block, at, kBc7RotationBits[mode]);
    at += kBc7RotationBits[mode];
    uint selection = bits(block, at, kBc7SelectionBits[mode]);
    at += kBc7SelectionBits[mode];

    uint colorBits = kBc7ColorBits[mode];
    uint alphaBits = kBc7AlphaBits[mode];
    uvec4 e0[3];
    uvec4 e1[3];
    for (uint ch = 0u; ch < 3u; ch++)
    {
        for (uint s = 0u; s < subsets; s++)
        {
            e0[s][ch] = bits(block, at, colorBits);
            at += colorBits;
            e1[s][ch] = bits(block, at, colorBits);
            at += colorBits;
        }
    }

    for (uint s = 0u; s < subsets; s++)
    {
        if (alphaBits != 0u)
        {
            e0[s].a = bits(block, at, alphaBits);
            at += alphaBits;
            e1[s].a = bits(block, at, alphaBits);
            at += alphaBits;
        }
        else
        {
            e0[s].a = 0u;
            e1[s].a = 0u;
        }
    }

    uint pBits = 0u;
    if (kBc7EndpointPBits[mode] != 0u)
    {
        pBits = 1u;
        for (uint s = 0u; s < subsets; s++)
        {
            uint p0 = bits(block, at, 1u);
            at += 1u;
            uint p1 = bits(block, at, 1u);
            at += 1u;
            e0[s] = (e0[s] << 1u) | p0;
            e1[s] = (e1[s] << 1u) | p1;
        }
    }
    else if (kBc7SharedPBits[mode] != 0u)
    {
        pBits = 1u;
        for (uint s = 0u; s < subsets; s++)
        {
            uint p = bits(block, at, 1u);
            at += 1u;
            e0[s] = (e0[s] << 1u) | p;
            e1[s] = (e1[s] << 1u) | p;
        }
    }

    uint cb = colorBits + pBits;
    uint ab = alphaBits + pBits;
    for (uint s = 0u; s < subsets; s++)
    {
        for (uint ch = 0u; ch < 3u; ch++)
        {
            e0[s][ch] = expand8(e0[s][ch], cb);
            e1[s][ch] = expand8(e1[s][ch], cb);
        }

        if (alphaBits != 0u)
        {
            e0[s].a = expand8(e0[s].a, ab);
            e1[s].a = expand8(e1[s].a, ab);
        }
        else
        {
            e0[s].a = 255u;
            e1[s].a = 255u;
        }
    }

    uint ib = kBc7IndexBits[mode];
    uint ib2 = kBc7Index2Bits[mode];
    uint anchorSecond = subsets == 2u ? anchor2(shape) : subsets == 3u ? anchor3Second(shape) : 0u;
    uint anchorThird = subsets == 3u ? anchor3Third(shape) : 0u;
    uint index[16];
    uint index2[16];
    for (uint i = 0u; i < 16u; i++)
    {
        bool anchor = i == 0u || (subsets >= 2u && i == anchorSecond) || (subsets == 3u && i == anchorThird);
        uint n = ib - (anchor ? 1u : 0u);
        index[i] = bits(block, at, n);
        at += n;
    }

    if (ib2 != 0u)
    {
        for (uint i = 0u; i < 16u; i++)
        {
            uint n = ib2 - (i == 0u ? 1u : 0u);
            index2[i] = bits(block, at, n);
            at += n;
        }
    }

    for (uint i = 0u; i < 16u; i++)
    {
        uint s = subsetOf(subsets, shape, i);
        uint colorIndex = index[i];
        uint alphaIndex = index[i];
        uint colorIndexBits = ib;
        uint alphaIndexBits = ib;
        if (ib2 != 0u)
        {
            if (selection != 0u)
            {
                colorIndex = index2[i];
                colorIndexBits = ib2;
            }
            else
            {
                alphaIndex = index2[i];
                alphaIndexBits = ib2;
            }
        }

        uint wc = weight(colorIndexBits, colorIndex);
        uint wa = weight(alphaIndexBits, alphaIndex);
        uvec4 c = uvec4(
            lerp64(e0[s].r, e1[s].r, wc),
            lerp64(e0[s].g, e1[s].g, wc),
            lerp64(e0[s].b, e1[s].b, wc),
            lerp64(e0[s].a, e1[s].a, wa));
        if (rotation == 1u)
            c = c.agbr;
        else if (rotation == 2u)
            c = c.rabg;
        else if (rotation == 3u)
            c = c.rgab;
        store(origin + uvec2(i & 3u, i >> 2u), z, c);
    }
}

