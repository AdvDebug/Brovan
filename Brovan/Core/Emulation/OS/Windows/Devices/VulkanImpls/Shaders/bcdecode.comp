#ifdef BC_DECODE_BC4

uint alphaIndex3s(uint w0, uint w1, uint i)
{
    uint at = 16u + 3u * i;
    uint v = at < 32u ? (w0 >> at) : (w1 >> (at - 32u));
    if (at < 32u && at + 3u > 32u)
        v |= w1 << (32u - at);
    return v & 7u;
}

// One 8-byte BC4 block as the two's complement bytes the substitute image stores.
void channelPalette(uint w0, bool signedValues, out uint a[8])
{
    if (!signedValues)
    {
        uint a0 = w0 & 255u;
        uint a1 = (w0 >> 8u) & 255u;
        a[0] = a0;
        a[1] = a1;
        if (a0 > a1)
        {
            for (uint k = 1u; k < 7u; k++)
                a[k + 1u] = ((7u - k) * a0 + k * a1 + 3u) / 7u;
        }
        else
        {
            for (uint k = 1u; k < 5u; k++)
                a[k + 1u] = ((5u - k) * a0 + k * a1 + 2u) / 5u;
            a[6] = 0u;
            a[7] = 255u;
        }
        return;
    }

    int s0 = (int(w0 & 255u) << 24) >> 24;
    int s1 = (int((w0 >> 8u) & 255u) << 24) >> 24;
    s0 = max(s0, -127);
    s1 = max(s1, -127);
    a[0] = uint(s0) & 255u;
    a[1] = uint(s1) & 255u;
    if (s0 > s1)
    {
        for (int k = 1; k < 7; k++)
            a[k + 1] = uint(int(round(float((7 - k) * s0 + k * s1) / 7.0))) & 255u;
    }
    else
    {
        for (int k = 1; k < 5; k++)
            a[k + 1] = uint(int(round(float((5 - k) * s0 + k * s1) / 5.0))) & 255u;
        a[6] = uint(-127) & 255u;
        a[7] = 127u;
    }
}

void decodeBc4(uvec2 origin, uint z, uvec4 block, bool signedValues)
{
    uint a[8];
    channelPalette(block.x, signedValues, a);
    uint one = signedValues ? 127u : 255u;
    for (uint i = 0u; i < 16u; i++)
        store(origin + uvec2(i & 3u, i >> 2u), z, uvec4(a[alphaIndex3s(block.x, block.y, i)], 0u, 0u, one));
}

void decodeBc5(uvec2 origin, uint z, uvec4 block, bool signedValues)
{
    uint r[8];
    uint g[8];
    channelPalette(block.x, signedValues, r);
    channelPalette(block.z, signedValues, g);
    uint one = signedValues ? 127u : 255u;
    for (uint i = 0u; i < 16u; i++)
        store(origin + uvec2(i & 3u, i >> 2u), z, uvec4(r[alphaIndex3s(block.x, block.y, i)], g[alphaIndex3s(block.z, block.w, i)], 0u, one));
}

