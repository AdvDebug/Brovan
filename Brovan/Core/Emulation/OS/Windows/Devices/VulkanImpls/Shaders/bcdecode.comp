#endif

void main()
{
    uvec3 id = gl_GlobalInvocationID;
    uint blocksX = (pc.width + 3u) >> 2u;
    uint blocksY = (pc.height + 3u) >> 2u;
    if (id.x >= blocksX || id.y >= blocksY || id.z >= pc.depth)
        return;

    uint family = pc.mode & kFamilyMask;
    uint wordsPerBlock = (family == kFamilyBc1 || family == kFamilyBc4) ? 2u : 4u;
    uint word = pc.wordOffset + (id.z * pc.blocksPerSlice + id.y * pc.blocksPerRow + id.x) * wordsPerBlock;
    uvec4 block = uvec4(blocks.words[word], blocks.words[word + 1u], 0u, 0u);
    if (wordsPerBlock == 4u)
    {
        block.z = blocks.words[word + 2u];
        block.w = blocks.words[word + 3u];
    }

    uvec2 origin = id.xy * 4u;
    bool signedValues = (pc.mode & kFlagSigned) != 0u;
    switch (family)
    {
#ifdef BC_DECODE_COLOR
        case kFamilyBc1:
            decodeBc1(origin, id.z, block, (pc.mode & kFlagPunchThrough) != 0u);
            break;
        case kFamilyBc2:
            decodeBc2(origin, id.z, block);
            break;
        case kFamilyBc3:
            decodeBc3(origin, id.z, block);
            break;
#endif
#ifdef BC_DECODE_BC4
        case kFamilyBc4:
            decodeBc4(origin, id.z, block, signedValues);
            break;
        case kFamilyBc5:
            decodeBc5(origin, id.z, block, signedValues);
            break;
#endif
#ifdef BC_DECODE_BC7
        case kFamilyBc7:
            decodeBc7(origin, id.z, block);
            break;
#endif
#ifdef BC_DECODE_BC6H
        case kFamilyBc6h:
            decodeBc6h(origin, id.z, block, signedValues);
            break;
#endif
        default:
            break;
    }
}
