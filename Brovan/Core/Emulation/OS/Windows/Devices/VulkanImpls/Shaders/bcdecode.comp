            by |= bits(block, 3u, 1u) << 4u;
            bz |= bits(block, 4u, 1u) << 4u;
            rw |= bits(block, 5u, 10u) << 0u;
            gw |= bits(block, 15u, 10u) << 0u;
            bw |= bits(block, 25u, 10u) << 0u;
            rx |= bits(block, 35u, 5u) << 0u;
            gz |= bits(block, 40u, 1u) << 4u;
            gy |= bits(block, 41u, 4u) << 0u;
            gx |= bits(block, 45u, 5u) << 0u;
            bz |= bits(block, 50u, 1u) << 0u;
            gz |= bits(block, 51u, 4u) << 0u;
            bx |= bits(block, 55u, 5u) << 0u;
            bz |= bits(block, 60u, 1u) << 1u;
            by |= bits(block, 61u, 4u) << 0u;
            ry |= bits(block, 65u, 5u) << 0u;
