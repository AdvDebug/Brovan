    uint gw = 0u, gx = 0u, gy = 0u, gz = 0u;
    uint bw = 0u, bx = 0u, by = 0u, bz = 0u;
    uint d = 0u;
    uint prec, dr, dg, db, subsets;
    bool transformed;
    switch (modeCode)
    {
        case 0u:
            prec = 10u; dr = 5u; dg = 5u; db = 5u; transformed = true; subsets = 2u;
