#version 450

// One invocation decodes one 4x4 block of a BCn buffer-to-image copy into the substitute image.
// Built by build.sh, one module per BC_OUT_* output format. Tables follow the Direct3D 11.3
// functional specification, sections 19 (BC6H) and 20 (BC7). Generated by gen_bcdecode.py.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly restrict buffer Blocks { uint words[]; } blocks;

#if defined(BC_OUT_RGBA8)
layout(set = 0, binding = 1, rgba8ui) uniform writeonly restrict uimage2DArray dst;
#define BC_DECODE_COLOR 1
#define BC_DECODE_BC4 1
#define BC_DECODE_BC7 1
#elif defined(BC_OUT_RG8)
layout(set = 0, binding = 1, rg8ui) uniform writeonly restrict uimage2DArray dst;
#define BC_DECODE_BC4 1
#elif defined(BC_OUT_R8)
layout(set = 0, binding = 1, r8ui) uniform writeonly restrict uimage2DArray dst;
#define BC_DECODE_BC4 1
#elif defined(BC_OUT_RGBA16)
layout(set = 0, binding = 1, rgba16ui) uniform writeonly restrict uimage2DArray dst;
#define BC_DECODE_BC6H 1
#else
#error "define one of BC_OUT_RGBA8, BC_OUT_RG8, BC_OUT_R8, BC_OUT_RGBA16"
#endif

layout(push_constant) uniform Push {
    uint wordOffset;
    uint blocksPerRow;
    uint blocksPerSlice;
    uint mode;
    uint dstX;
    uint dstY;
    uint dstZ;
    uint width;
    uint height;
    uint depth;
} pc;

