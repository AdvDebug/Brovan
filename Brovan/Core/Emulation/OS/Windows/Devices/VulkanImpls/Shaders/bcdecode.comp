#ifdef BC_DECODE_BC6H

int signExtend(uint v, uint n)
{
    return (int(v) << (32u - n)) >> (32u - n);
}

int wrapEndpoint(int v, uint prec, bool signedFormat)
{
    uint w = uint(v) & ((1u << prec) - 1u);
    return signedFormat ? signExtend(w, prec) : int(w);
}

int unquantize(int x, uint prec, bool signedFormat)
{
    if (signedFormat)
    {
        if (prec >= 16u)
            return x;
        bool negative = x < 0;
        uint m = uint(negative ? -x : x);
        uint r;
        if (m == 0u)
            r = 0u;
        else if (m >= (1u << (prec - 1u)) - 1u)
            r = 0x7FFFu;
        else
            r = ((m << 15u) + 0x4000u) >> (prec - 1u);
        return negative ? -int(r) : int(r);
    }

    if (prec >= 15u)
        return x;
    uint m = uint(x);
    if (m == 0u)
        return 0;
    if (m == (1u << prec) - 1u)
        return 0xFFFF;
    return int(((m << 16u) + 0x8000u) >> prec);
}

uint toHalf(int v, bool signedFormat)
{
    if (!signedFormat)
        return uint(v * 31) >> 6u;
    return v < 0 ? (0x8000u | (uint(-v * 31) >> 5u)) : (uint(v * 31) >> 5u);
}

void decodeBc6h(uvec2 origin, uint z, uvec4 block, bool signedFormat)
{
    uint low = block.x & 3u;
    uint modeCode = low < 2u ? low : (block.x & 31u);
