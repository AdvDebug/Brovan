const uint kWeights3[8] = uint[8](0u, 9u, 18u, 27u, 37u, 46u, 55u, 64u);
const uint kWeights4[16] = uint[16](0u, 4u, 9u, 13u, 17u, 21u, 26u, 30u, 34u, 38u, 43u, 47u, 51u, 55u, 60u, 64u);

uint bits(uvec4 block, uint at, uint n)
{
    uint w = at >> 5u;
    uint o = at & 31u;
    uint v = block[w] >> o;
    if (o + n > 32u)
        v |= block[w + 1u] << (32u - o);
    return n >= 32u ? v : (v & ((1u << n) - 1u));
}

uint weight(uint indexBits, uint index)
{
    return indexBits == 2u ? kWeights2[index] : indexBits == 3u ? kWeights3[index] : kWeights4[index];
}

uint lerp64(uint a, uint b, uint w)
{
    return (a * (64u - w) + b * w + 32u) >> 6u;
}

int lerp64s(int a, int b, uint w)
{
    return (a * int(64u - w) + b * int(w) + 32) >> 6;
}

uint anchor2(uint shape)
{
    return (kAnchor2[shape >> 3u] >> (4u * (shape & 7u))) & 15u;
}

uint anchor3Second(uint shape)
{
    return (kAnchor3Second[shape >> 3u] >> (4u * (shape & 7u))) & 15u;
}

uint anchor3Third(uint shape)
{
    return (kAnchor3Third[shape >> 3u] >> (4u * (shape & 7u))) & 15u;
}

void store(uvec2 texel, uint z, uvec4 value)
{
    if (texel.x < pc.width && texel.y < pc.height)
        imageStore(dst, ivec3(int(pc.dstX + texel.x), int(pc.dstY + texel.y), int(pc.dstZ + z)), value);
}

void fill(uvec2 origin, uint z, uvec4 value)
{
    for (uint i = 0u; i < 16u; i++)
        store(origin + uvec2(i & 3u, i >> 2u), z, value);
}

#ifdef BC_DECODE_COLOR

uvec3 rgb565(uint c)
{
    uint r = (c >> 11u) & 31u;
    uint g = (c >> 5u) & 63u;
    uint b = c & 31u;
    return uvec3((r << 3u) | (r >> 2u), (g << 2u) | (g >> 4u), (b << 3u) | (b >> 2u));
}

void colorPalette(uint w0, bool fourColors, bool punchThrough, out uvec4 c[4])
{
    uint c0 = w0 & 0xFFFFu;
    uint c1 = w0 >> 16u;
    uvec3 p0 = rgb565(c0);
    uvec3 p1 = rgb565(c1);
    c[0] = uvec4(p0, 255u);
    c[1] = uvec4(p1, 255u);
    if (fourColors || c0 > c1)
    {
        c[2] = uvec4((2u * p0 + p1 + 1u) / 3u, 255u);
        c[3] = uvec4((p0 + 2u * p1 + 1u) / 3u, 255u);
    }
    else
    {
        c[2] = uvec4((p0 + p1 + 1u) / 2u, 255u);
        c[3] = uvec4(0u, 0u, 0u, punchThrough ? 0u : 255u);
    }
}

uint alphaIndex3(uint w0, uint w1, uint i)
{
    uint at = 16u + 3u * i;
    uint v = at < 32u ? (w0 >> at) : (w1 >> (at - 32u));
    if (at < 32u && at + 3u > 32u)
        v |= w1 << (32u - at);
    return v & 7u;
}

void alphaPalette(uint a0, uint a1, out uint a[8])
{
    a[0] = a0;
    a[1] = a1;
    if (a0 > a1)
    {
        for (uint k = 1u; k < 7u; k++)
            a[k + 1u] = ((7u - k) * a0 + k * a1 + 3u) / 7u;
    }
    else
    {
        for (uint k = 1u; k < 5u; k++)
            a[k + 1u] = ((5u - k) * a0 + k * a1 + 2u) / 5u;
        a[6] = 0u;
        a[7] = 255u;
    }
}

void decodeBc1(uvec2 origin, uint z, uvec4 block, bool punchThrough)
{
    uvec4 c[4];
    colorPalette(block.x, false, punchThrough, c);
    for (uint i = 0u; i < 16u; i++)
        store(origin + uvec2(i & 3u, i >> 2u), z, c[(block.y >> (2u * i)) & 3u]);
}

void decodeBc2(uvec2 origin, uint z, uvec4 block)
{
    uvec4 c[4];
    colorPalette(block.z, true, false, c);
    for (uint i = 0u; i < 16u; i++)
    {
        uint a4 = (i < 8u ? (block.x >> (4u * i)) : (block.y >> (4u * (i - 8u)))) & 15u;
        uvec4 t = c[(block.w >> (2u * i)) & 3u];
        t.a = a4 * 17u;
        store(origin + uvec2(i & 3u, i >> 2u), z, t);
    }
}

void decodeBc3(uvec2 origin, uint z, uvec4 block)
{
    uvec4 c[4];
    colorPalette(block.z, true, false, c);
    uint a[8];
    alphaPalette(block.x & 255u, (block.x >> 8u) & 255u, a);
    for (uint i = 0u; i < 16u; i++)
    {
        uvec4 t = c[(block.w >> (2u * i)) & 3u];
        t.a = a[alphaIndex3(block.x, block.y, i)];
        store(origin + uvec2(i & 3u, i >> 2u), z, t);
    }
}

