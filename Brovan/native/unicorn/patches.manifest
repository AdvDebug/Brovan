# Brovan patch manifest for the Unicorn source tree.
#
# Applied by the PatchUnicornSource target in Brovan.Unicorn.targets after the
# tarball is extracted. Every rule is idempotent and every missing anchor is a
# hard build error, so a silently unpatched unicorn cannot be produced.
#
# Rule syntax, '|' separated:
#   schema|<n>
#   validated|<unicorn tags these anchors were checked against>
#   copy|<file in this directory>|<destination relative to the unicorn root>
#   insert-after|<file>|<anchor line, trimmed>|<line to insert>
#   insert-before|<file>|<anchor line, trimmed>|<line to insert>
#   insert-in-body|<file>|<function signature line>|<line to insert after its '{'>
#   replace-all|<file>|<exact substring>|<replacement>
#   append|<file>|<line to append>
#
# Anchors are deliberately single lines or whole-file appends: those survive
# upstream edits to the surrounding code, hunk-based diffs do not.
#
# Two properties of the applier to write rules against:
#   - '|' is the field separator, so no rule text may contain one.
#   - the "already applied" test looks for the inserted line anywhere in the
#     file, not next to the anchor, so an inserted line that also occurs
#     elsewhere is silently skipped. Make inserted lines distinctive.

schema|1
validated|2.1.4

copy|brovan_uc.h|include/brovan_uc.h
copy|brovan_uc_api.inc.c|include/brovan_uc_api.inc.c
copy|brovan_uc_tcg_decls.inc.h|include/brovan_uc_tcg_decls.inc.h
copy|brovan_uc_tcg.inc.c|include/brovan_uc_tcg.inc.c
copy|brovan_tcg_slots.inc.c|include/brovan_tcg_slots.inc.c
copy|brovan_tcg_exitcheck.inc.h|include/brovan_tcg_exitcheck.inc.h
copy|brovan_tcg_budget.inc.h|include/brovan_tcg_budget.inc.h
copy|brovan_mem_hooks.inc.h|include/brovan_mem_hooks.inc.h
copy|brovan_notdirty.inc.h|include/brovan_notdirty.inc.h
copy|brovan_flatview.inc.c|include/brovan_flatview.inc.c
copy|brovan_ramblock.inc.h|include/brovan_ramblock.inc.h
copy|brovan_softfloat_fast.inc.h|include/brovan_softfloat_fast.inc.h
copy|brovan_softfloat_cmp.inc.c|include/brovan_softfloat_cmp.inc.c
copy|brovan_sse_fastconv.inc.h|include/brovan_sse_fastconv.inc.h

# --- uc_struct gains the brov ops table and the inline-hook switch -----------
insert-after|include/uc_priv.h|#include "list.h"|#include "brovan_uc.h"
insert-after|include/uc_priv.h|uc_del_inline_hook_t del_inline_hook;|    BROVAN_UC_FIELDS

# --- TCGContext gains the slot table and the cache counters -----------------
insert-before|qemu/include/tcg/tcg.h|struct TCGContext {|#include "brovan_uc.h"
insert-after|qemu/include/tcg/tcg.h|struct uc_struct *uc;|    BROVAN_TCG_FIELDS

# --- uc is pinned in the reservation: it is baked in by tcg_const_ptr(uc) ----
replace-all|uc.c|uc = calloc(1, sizeof(*uc));|uc = brov_alloc_uc(sizeof(*uc));
replace-all|uc.c|free(uc);|brov_free_uc(uc);
append|uc.c|#include "brovan_uc_api.inc.c"

# --- code buffer, slot table, ops install -----------------------------------
insert-after|qemu/accel/tcg/translate-all.c|#include "uc_priv.h"|#include "brovan_uc_tcg_decls.inc.h"
replace-all|qemu/accel/tcg/translate-all.c|uc->tcg_ctx = g_malloc(sizeof(TCGContext));|uc->tcg_ctx = brov_alloc_arena(sizeof(TCGContext));
insert-before|qemu/accel/tcg/translate-all.c|tcg_ctx->code_gen_buffer_size = size_code_gen_buffer(tb_size);|    if (brov_try_alloc_code_gen_buffer(uc, tb_size)) { return; }
insert-after|qemu/accel/tcg/translate-all.c|uc->tb_flush = uc_tb_flush;|    brov_install(uc);
replace-all|qemu/accel/tcg/translate-all.c|if (tcg_ctx->initial_buffer) {|if (tcg_ctx->initial_buffer && !brov_owns_code_gen_buffer(uc)) {
append|qemu/accel/tcg/translate-all.c|#include "brovan_uc_tcg.inc.c"


# --- per-block exit poll: load+branch on the fast path, helper on the slow one
insert-before|qemu/include/exec/gen-icount.h|static inline void gen_tb_start(TCGContext *tcg_ctx, TranslationBlock *tb)|#include "brovan_tcg_exitcheck.inc.h"
replace-all|qemu/include/exec/gen-icount.h|gen_helper_check_exit_request(tcg_ctx, puc, tmp);|brov_gen_exit_check_start(tcg_ctx, puc, tmp);
replace-all|qemu/include/exec/gen-icount.h|tcg_gen_exit_tb(tcg_ctx, tb, TB_EXIT_REQUESTED);|brov_gen_exit_check_end(tcg_ctx, num_insns); tcg_gen_exit_tb(tcg_ctx, tb, TB_EXIT_REQUESTED);

# --- instruction budget: a per-block decrement instead of a code hook --------
insert-after|qemu/include/exec/cpu-defs.h|IcountDecr icount_decr;|    int32_t brov_insn_budget;
insert-after|qemu/accel/tcg/tcg-runtime.c|#include <uc_priv.h>|#include "brovan_tcg_budget.inc.h"
insert-after|qemu/accel/tcg/tcg-runtime.c|void HELPER(check_exit_request)(void *p, uint32_t in_delay_slot) {|    brov_budget_expired((struct uc_struct *)p);
insert-after|qemu/accel/tcg/cpu-exec.c|#include "uc_priv.h"|#include "brovan_tcg_budget.inc.h"
insert-before|qemu/accel/tcg/cpu-exec.c|insns_left = cpu_neg(cpu)->icount_decr.u32;|    brov_budget_expired(cpu->uc);
insert-after|uc.c|uc->emu_count = count;|    brov_arm_budget(uc, count);

# --- guest stores keep the inline TLB path unless a hook can see them --------
insert-before|qemu/include/exec/exec-all.h|static inline bool uc_mem_hook_installed(struct uc_struct *uc, hwaddr paddr)|#include "brovan_mem_hooks.inc.h"
insert-in-body|qemu/include/exec/exec-all.h|static inline bool uc_mem_hook_installed(struct uc_struct *uc, hwaddr paddr)|    return brov_mem_hook_needs_slow_path(uc, paddr);
insert-after|qemu/accel/tcg/cputlb.c|#include <glib_compat.h>|#include "brovan_notdirty.inc.h"
insert-in-body|qemu/accel/tcg/cputlb.c|static void notdirty_write(CPUState *cpu, vaddr mem_vaddr, unsigned size,|    if (brov_notdirty_promote(cpu, mem_vaddr, tlbe)) { tlb_set_dirty(cpu, mem_vaddr); }
insert-before|uc.c|if (remove_exec) {|    uc->tcg_flush_tlb(uc); /* brov: a cached TLB entry may predate these perms */
replace-all|uc.c|if (count > 0 && uc->count_hook == 0) {|if (count > 0 && uc->count_hook == 0 && !uc->brov_budget_mode) {

# --- no exit poll after every guest memory access, faults leave the helper ---
replace-all|qemu/accel/tcg/cputlb.c|cpu_exit(uc->cpu);|brov_fault_exit(uc, retaddr);
insert-in-body|qemu/tcg/tcg-op.c|void check_exit_request(TCGContext *tcg_ctx)|    if (brov_access_exit_check_elided(tcg_ctx->uc)) { return; }

# --- block lookups, a bigger jump cache and the ram offset from the TLB entry
replace-all|qemu/include/hw/core/cpu.h|#define TB_JMP_CACHE_BITS 12|#define TB_JMP_CACHE_BITS 15
replace-all|qemu/accel/tcg/cputlb.c|return qemu_ram_addr_from_host_nofail(env->uc, p);|return (tb_page_addr_t)addr + env_tlb(env)->d[mmu_idx].iotlb[index].addr; /* brov: the entry already carries the ram offset */

# --- eip and cc_op are stored before these helpers run, so no PC restore -----
replace-all|qemu/target/i386/seg_helper.c|cpu_restore_state(uc->cpu, pc, false);|/* brov: eip and cc_op were stored ahead of this helper */
replace-all|qemu/target/i386/misc_helper.c|cpu_restore_state(uc->cpu, pc, false);|/* brov: eip and cc_op were stored ahead of this helper */

# --- rdtsc from the embedder's clock, no hook round trip ---------------------
insert-in-body|qemu/target/i386/misc_helper.c|void helper_rdtsc(CPUX86State *env)|    if (env->uc->brov_tsc.armed) { uint64_t brov_val = brov_tsc_now(env->uc); env->regs[R_EAX] = (uint32_t)brov_val; env->regs[R_EDX] = (uint32_t)(brov_val >> 32); return; }

# --- a pause loop gives up its slice early -----------------------------------
insert-after|qemu/target/i386/misc_helper.c|#include "uc_priv.h"|#include "brovan_tcg_budget.inc.h"
insert-in-body|qemu/target/i386/misc_helper.c|static void do_pause(X86CPU *cpu)|    brov_charge_pause(CPU(cpu));
replace-all|qemu/target/i386/translate.c|gen_helper_pause(tcg_ctx, tcg_ctx->cpu_env, tcg_const_i32(tcg_ctx, s->pc - pc_start));|if (tcg_ctx->uc->brov_budget_mode) { brov_gen_pause_charge(tcg_ctx); break; } gen_helper_pause(tcg_ctx, tcg_ctx->cpu_env, tcg_const_i32(tcg_ctx, s->pc - pc_start));

# --- helper calls route through the slot table ------------------------------
insert-before|qemu/tcg/i386/tcg-target.inc.c|static inline void tcg_out_call(TCGContext *s, tcg_insn_unit *dest)|#include "brovan_tcg_slots.inc.c"
insert-in-body|qemu/tcg/i386/tcg-target.inc.c|static inline void tcg_out_call(TCGContext *s, tcg_insn_unit *dest)|    if (brov_tcg_out_call_slot(s, dest)) { return; }
insert-in-body|qemu/tcg/i386/tcg-target.inc.c|static void tcg_out_jmp(TCGContext *s, tcg_insn_unit *dest)|    if (brov_tcg_out_jmp_slot(s, dest)) { return; }
insert-before|qemu/tcg/aarch64/tcg-target.inc.c|static inline void tcg_out_call(TCGContext *s, tcg_insn_unit *target)|#include "brovan_tcg_slots.inc.c"
insert-in-body|qemu/tcg/aarch64/tcg-target.inc.c|static inline void tcg_out_call(TCGContext *s, tcg_insn_unit *target)|    if (brov_tcg_out_call_slot(s, target)) { return; }

# --- softmmu TLB sizing -----------------------------------------------------
replace-all|qemu/include/exec/cpu-defs.h|#define CPU_TLB_DYN_MIN_BITS 6|#define CPU_TLB_DYN_MIN_BITS 14
replace-all|qemu/include/exec/cpu-defs.h|#define CPU_TLB_DYN_DEFAULT_BITS 8|#define CPU_TLB_DYN_DEFAULT_BITS 14

# --- the SSE register file is aligned for vector access ---------------------
replace-all|qemu/target/i386/cpu.h|ZMMReg xmm_regs[CPU_NB_REGS == 8 ? 8 : 32];|QEMU_ALIGN(16, ZMMReg) xmm_regs[CPU_NB_REGS == 8 ? 8 : 32];
replace-all|qemu/target/i386/cpu.h|ZMMReg xmm_t0;|QEMU_ALIGN(16, ZMMReg) xmm_t0;

# --- MSVC lacks flatten: hardfloat dispatch is inlined by hand ---------------
insert-before|qemu/fpu/softfloat.c|static inline bool can_use_fpu(const float_status *s)|#include "brovan_softfloat_fast.inc.h"
replace-all|qemu/fpu/softfloat.c|static inline bool f32_is_zon2(union_float32 a, union_float32 b)|static BROV_SF_INLINE bool f32_is_zon2(union_float32 a, union_float32 b)
replace-all|qemu/fpu/softfloat.c|static inline bool f64_is_zon2(union_float64 a, union_float64 b)|static BROV_SF_INLINE bool f64_is_zon2(union_float64 a, union_float64 b)
replace-all|qemu/fpu/softfloat.c|static float32 float32_addsub(float32 a, float32 b, float_status *s,|static BROV_SF_INLINE float32 float32_addsub(float32 a, float32 b, float_status *s,
replace-all|qemu/fpu/softfloat.c|static float64 float64_addsub(float64 a, float64 b, float_status *s,|static BROV_SF_INLINE float64 float64_addsub(float64 a, float64 b, float_status *s,

# --- isless and friends are CRT calls under MSVC; operators inline -----------
replace-all|qemu/fpu/softfloat.c|    if (isgreaterequal(ua.h, ub.h)) {|    if (ua.h >= ub.h) {
replace-all|qemu/fpu/softfloat.c|        if (isgreater(ua.h, ub.h)) {|        if (ua.h > ub.h) {
replace-all|qemu/fpu/softfloat.c|    if (likely(isless(ua.h, ub.h))) {|    if (likely(ua.h < ub.h)) {

# --- min/max/cmp compares answer ordered operands on the host ----------------
replace-all|qemu/fpu/softfloat.c|int float32_lt(float32 a, float32 b, float_status *status)|static int brov_soft_float32_lt(float32 a, float32 b, float_status *status)
replace-all|qemu/fpu/softfloat.c|int float32_le(float32 a, float32 b, float_status *status)|static int brov_soft_float32_le(float32 a, float32 b, float_status *status)
replace-all|qemu/fpu/softfloat.c|int float32_eq_quiet(float32 a, float32 b, float_status *status)|static int brov_soft_float32_eq_quiet(float32 a, float32 b, float_status *status)
replace-all|qemu/fpu/softfloat.c|int float32_unordered_quiet(float32 a, float32 b, float_status *status)|static int brov_soft_float32_unordered_quiet(float32 a, float32 b, float_status *status)
replace-all|qemu/fpu/softfloat.c|int float64_lt(float64 a, float64 b, float_status *status)|static int brov_soft_float64_lt(float64 a, float64 b, float_status *status)
replace-all|qemu/fpu/softfloat.c|int float64_le(float64 a, float64 b, float_status *status)|static int brov_soft_float64_le(float64 a, float64 b, float_status *status)
replace-all|qemu/fpu/softfloat.c|int float64_eq_quiet(float64 a, float64 b, float_status *status)|static int brov_soft_float64_eq_quiet(float64 a, float64 b, float_status *status)
replace-all|qemu/fpu/softfloat.c|int float64_unordered_quiet(float64 a, float64 b, float_status *status)|static int brov_soft_float64_unordered_quiet(float64 a, float64 b, float_status *status)
append|qemu/fpu/softfloat.c|#include "brovan_softfloat_cmp.inc.c"

# --- conversions answer in-range finite values on the host -------------------
insert-before|qemu/target/i386/ops_sse.h|void helper_cvtdq2ps(CPUX86State *env, Reg *d, Reg *s)|#include "brovan_sse_fastconv.inc.h"
replace-all|qemu/target/i386/ops_sse.h|int32_to_float64(l0, &env->sse_status)|brov_i32_to_f64(l0)
replace-all|qemu/target/i386/ops_sse.h|int32_to_float64(l1, &env->sse_status)|brov_i32_to_f64(l1)
replace-all|qemu/target/i386/ops_sse.h|int32_to_float64(s->MMX_L(0), &env->sse_status)|brov_i32_to_f64(s->MMX_L(0))
replace-all|qemu/target/i386/ops_sse.h|int32_to_float64(s->MMX_L(1), &env->sse_status)|brov_i32_to_f64(s->MMX_L(1))
replace-all|qemu/target/i386/ops_sse.h|int32_to_float64(val, &env->sse_status)|brov_i32_to_f64(val)
replace-all|qemu/target/i386/ops_sse.h|int32_to_float32(s->ZMM_L(0), &env->sse_status)|brov_i32_to_f32(s->ZMM_L(0), &env->sse_status)
replace-all|qemu/target/i386/ops_sse.h|int32_to_float32(s->ZMM_L(1), &env->sse_status)|brov_i32_to_f32(s->ZMM_L(1), &env->sse_status)
replace-all|qemu/target/i386/ops_sse.h|int32_to_float32(s->ZMM_L(2), &env->sse_status)|brov_i32_to_f32(s->ZMM_L(2), &env->sse_status)
replace-all|qemu/target/i386/ops_sse.h|int32_to_float32(s->ZMM_L(3), &env->sse_status)|brov_i32_to_f32(s->ZMM_L(3), &env->sse_status)
replace-all|qemu/target/i386/ops_sse.h|int32_to_float32(s->MMX_L(0), &env->sse_status)|brov_i32_to_f32(s->MMX_L(0), &env->sse_status)
replace-all|qemu/target/i386/ops_sse.h|int32_to_float32(s->MMX_L(1), &env->sse_status)|brov_i32_to_f32(s->MMX_L(1), &env->sse_status)
replace-all|qemu/target/i386/ops_sse.h|int32_to_float32(val, &env->sse_status)|brov_i32_to_f32(val, &env->sse_status)
replace-all|qemu/target/i386/ops_sse.h|WRAP_FLOATCONV(int32_t, float32_to_int32_round_to_zero, float32, INT32_MIN)|/* x86_float32_to_int32_round_to_zero: brovan_sse_fastconv.inc.h */
replace-all|qemu/target/i386/ops_sse.h|WRAP_FLOATCONV(int32_t, float64_to_int32_round_to_zero, float64, INT32_MIN)|/* x86_float64_to_int32_round_to_zero: brovan_sse_fastconv.inc.h */
replace-all|qemu/target/i386/ops_sse.h|WRAP_FLOATCONV(int64_t, float32_to_int64_round_to_zero, float32, INT64_MIN)|/* x86_float32_to_int64_round_to_zero: brovan_sse_fastconv.inc.h */
replace-all|qemu/target/i386/ops_sse.h|WRAP_FLOATCONV(int64_t, float64_to_int64_round_to_zero, float64, INT64_MIN)|/* x86_float64_to_int64_round_to_zero: brovan_sse_fastconv.inc.h */

# --- hardfloat is armed from reset, not from the first soft op ---------------
insert-after|qemu/target/i386/fpu_helper.c|#include "cpu.h"|#include "brovan_softfloat_fast.inc.h"
insert-after|qemu/target/i386/fpu_helper.c|set_flush_inputs_to_zero((mxcsr & SSE_DAZ) ? 1 : 0, &env->sse_status);|    brov_seed_inexact(&env->sse_status);
insert-after|qemu/target/i386/cpu.c|#include "cpu.h"|#include "brovan_softfloat_fast.inc.h"
insert-after|qemu/target/i386/cpu.c|env->mxcsr = 0x1f80;|    brov_seed_inexact(&env->sse_status);

# --- MXCSR.FZ reaches the SSE status, not the x87 one -----------------------
replace-all|qemu/target/i386/fpu_helper.c|set_flush_to_zero((mxcsr & SSE_FZ) ? 1 : 0, &env->fp_status);|set_flush_to_zero((mxcsr & SSE_FZ) ? 1 : 0, &env->sse_status);

# --- a new region is inserted into the live flat view, not re-rendered ------
insert-after|qemu/softmmu/memory.c|#include "uc_priv.h"|static bool brov_flatview_add(MemoryRegion *mr);
insert-after|qemu/softmmu/memory.c|static bool brov_flatview_add(MemoryRegion *mr);|static void brov_dispatch_compact(FlatView *fv);
replace-all|qemu/softmmu/memory.c|    memory_region_transaction_commit(subregion);|    if (!brov_flatview_add(subregion)) { memory_region_transaction_commit(subregion); }
append|qemu/softmmu/memory.c|#include "brovan_flatview.inc.c"

# --- the mru lookup cache cannot outlive a section-array realloc -------------
insert-in-body|qemu/exec.c|static uint16_t phys_section_add(struct uc_struct *uc, PhysPageMap *map,|    container_of(map, AddressSpaceDispatch, map)->mru_section = NULL; /* brov: the array can move while the dispatch is live */

# --- only the view the insert mutates skips compaction, not every dispatch ---
replace-all|qemu/softmmu/memory.c|address_space_dispatch_compact(view->dispatch);|brov_dispatch_compact(view);
replace-all|qemu/softmmu/memory.c|address_space_dispatch_compact(dst->dispatch);|brov_dispatch_compact(dst);
replace-all|qemu/softmmu/memory.c|address_space_dispatch_compact(fv->dispatch);|brov_dispatch_compact(fv);

# --- a RAMBlock no larger than the smallest one belongs at the tail ----------
insert-after|qemu/exec.c|#include "uc_priv.h"|#include "brovan_ramblock.inc.h"
replace-all|qemu/exec.c|new_block->max_length > uc->target_page_size|brov_ramblock_needs_sort_walk(uc, new_block)
replace-all|qemu/exec.c|if (uc->ram_list.freed|if (0 /* brov: a freed block no longer forces the walk */ 
replace-all|qemu/exec.c|if (!uc->ram_list.freed) {|{ ram_addr_t brov_off; if (brov_find_ram_offset(uc, size, &brov_off)) { return brov_off; } } if (!uc->ram_list.freed) {

