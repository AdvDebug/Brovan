 static bool
+lower_r11g11b10f_attrib(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   nir_variable **vars = data;
+   if (intr->intrinsic != nir_intrinsic_load_deref || nir_intrinsic_get_var(intr, 0) != vars[0])
+      return false;
+   b->cursor = nir_after_instr(&intr->instr);
+   nir_def *packed = nir_load_deref(b, nir_build_deref_var(b, vars[1]));
+   /* Avoid nir_format_unpack_11f11f10f, which needs 16-bit types. */
+   nir_def *rgba[4] = {
+      nir_mask_shift(b, packed, 0x000007ff, 4),
+      nir_mask_shift(b, packed, 0x003ff800, -7),
+      nir_mask_shift(b, packed, 0xffc00000, -17),
+      nir_imm_float(b, 1.0),
+   };
+   for (unsigned c = 0; c < 3; c++)
+      rgba[c] = nir_channel(b, nir_unpack_half_2x16(b, rgba[c]), 0);
+   nir_def_rewrite_uses(&intr->def, nir_trim_vector(b, nir_vec(b, rgba, 4), intr->def.num_components));
+   nir_instr_remove(&intr->instr);
+   return true;
+}
+
+static bool
+unpack_r11g11b10f_attribs(nir_shader *nir, uint32_t attrs)
+{
+   u_foreach_bit(location, attrs) {
+      nir_variable *var = nir_find_variable_with_driver_location(nir, nir_var_shader_in, location);
+      if (!var)
+         continue;
+      nir_variable *vars[2] = { var, nir_variable_clone(var, nir) };
+      nir_variable_set_namef(nir, vars[1], "%s_r11g11b10f", var->name);
+      vars[1]->type = glsl_uint_type();
+      nir_shader_add_variable(nir, vars[1]);
+      var->data.mode = nir_var_shader_temp;
+      nir_shader_intrinsics_pass(nir, lower_r11g11b10f_attrib, nir_metadata_control_flow, vars);
+   }
+   nir_fixup_deref_modes(nir);
+   NIR_PASS(_, nir, nir_remove_dead_variables, nir_var_shader_temp, NULL);
+   optimize_nir(nir, NULL, true);
+   return true;
+}
