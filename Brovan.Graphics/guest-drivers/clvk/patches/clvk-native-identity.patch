+#include "kmt.hpp"
+
+#ifdef _WIN32
+
+#include <windows.h>
+
+#include <cstring>
+
+namespace {
+
+// d3dkmthk.h and d3dukmdt.h
+constexpr int KmtQueryRegistry = 48;
+constexpr UINT RegistryAdapterKey = 1;
+constexpr UINT RegistryStatusSuccess = 0;
+constexpr int MaxValueChars = 128;
+
+struct OpenAdapterFromLuid {
+    LUID AdapterLuid;
+    UINT Adapter;
+};
+
+struct QueryAdapterInfo {
+    UINT Adapter;
+    int Type;
+    void* Data;
+    UINT DataSize;
+};
+
+struct CloseAdapter {
+    UINT Adapter;
+};
+
+struct RegistryInfo {
+    UINT QueryType;
+    UINT QueryFlags;
+    WCHAR ValueName[MAX_PATH];
+    ULONG ValueType;
+    ULONG PhysicalAdapterIndex;
+    ULONG OutputValueSize;
+    UINT Status;
+    alignas(8) WCHAR Output[MaxValueChars];
+};
+
+using OpenFn = LONG(APIENTRY*)(OpenAdapterFromLuid*);
+using QueryFn = LONG(APIENTRY*)(QueryAdapterInfo*);
+using CloseFn = LONG(APIENTRY*)(CloseAdapter*);
+
+struct kmt_entries {
+    OpenFn open = nullptr;
+    QueryFn query = nullptr;
+    CloseFn close = nullptr;
+
+    kmt_entries() {
+        HMODULE gdi = LoadLibraryW(L"gdi32.dll");
+        if (gdi == nullptr) {
+            return;
+        }
+        open = reinterpret_cast<OpenFn>(
+            GetProcAddress(gdi, "D3DKMTOpenAdapterFromLuid"));
+        query = reinterpret_cast<QueryFn>(
+            GetProcAddress(gdi, "D3DKMTQueryAdapterInfo"));
+        close =
+            reinterpret_cast<CloseFn>(GetProcAddress(gdi, "D3DKMTCloseAdapter"));
+    }
+};
+
+const kmt_entries& entries() {
+    static const kmt_entries loaded;
+    return loaded;
+}
+
+bool open_adapter(const uint8_t* luid, UINT* adapter) {
+    const auto& kmt = entries();
+    if (kmt.open == nullptr || kmt.close == nullptr) {
+        return false;
+    }
+    OpenAdapterFromLuid args{};
+    memcpy(&args.AdapterLuid, luid, sizeof(args.AdapterLuid));
+    if (kmt.open(&args) != 0) {
+        return false;
+    }
+    *adapter = args.Adapter;
+    return true;
+}
+
+void close_adapter(UINT adapter) {
+    CloseAdapter args{adapter};
+    entries().close(&args);
+}
+
+} // namespace
+
+bool cvk_kmt_has_adapter(const uint8_t* luid) {
+    UINT adapter;
+    if (!open_adapter(luid, &adapter)) {
+        return false;
+    }
+    close_adapter(adapter);
+    return true;
+}
+
+bool cvk_kmt_read_adapter_string(const uint8_t* luid, const wchar_t* name,
+                                 std::string* value) {
+    const auto& kmt = entries();
+    UINT adapter;
+    if (kmt.query == nullptr || wcslen(name) >= MAX_PATH ||
+        !open_adapter(luid, &adapter)) {
+        return false;
+    }
+
+    RegistryInfo info{};
+    info.QueryType = RegistryAdapterKey;
+    info.ValueType = REG_SZ;
+    wcscpy_s(info.ValueName, name);
+    QueryAdapterInfo args{adapter, KmtQueryRegistry, &info, sizeof(info)};
+    bool found = kmt.query(&args) == 0 && info.Status == RegistryStatusSuccess &&
+                 info.OutputValueSize <= sizeof(info.Output);
+    close_adapter(adapter);
+    if (!found) {
+        return false;
+    }
+
+    size_t chars = info.OutputValueSize / sizeof(WCHAR);
+    while (chars > 0 && info.Output[chars - 1] == L'\0') {
+        chars--;
+    }
+    if (chars == 0) {
+        return false;
+    }
+    int bytes = WideCharToMultiByte(CP_UTF8, 0, info.Output, (int)chars,
+                                    nullptr, 0, nullptr, nullptr);
+    if (bytes <= 0) {
+        return false;
+    }
+    value->resize(bytes);
+    WideCharToMultiByte(CP_UTF8, 0, info.Output, (int)chars, value->data(),
+                        bytes, nullptr, nullptr);
+    return true;
+}
+
+#else
+
+bool cvk_kmt_has_adapter(const uint8_t*) { return false; }
+
+bool cvk_kmt_read_adapter_string(const uint8_t*, const wchar_t*,
+                                 std::string*) {
+    return false;
+}
+
+#endif
