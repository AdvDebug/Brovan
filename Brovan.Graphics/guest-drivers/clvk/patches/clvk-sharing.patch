+// The content of one memory object that belongs to an object of another API.
+// The client copies between that object and a host block packed as the
+// memory object's region; the core moves the block in and out of the memory
+// object on the command queue.
+struct cvk_interop_object {
+    cvk_interop_object(cvk_interop_device* device, void* external,
+                       uint32_t subresource)
+        : m_device(device), m_external(external), m_subresource(subresource) {}
+    virtual ~cvk_interop_object();
+
+    // External content into the host block, and back. The device runs them,
+    // on the thread its API needs.
+    CHECK_RETURN virtual cl_int capture() = 0;
+    CHECK_RETURN virtual cl_int publish() = 0;
+
+    cvk_interop_device* device() const { return m_device; }
+    void* external() const { return m_external; }
+    uint32_t subresource() const { return m_subresource; }
+
+    // Sizes the host block for rows of row_bytes, rows per slice, slices.
+    // CL_OUT_OF_RESOURCES above max_bytes.
+    CHECK_RETURN cl_int set_layout(size_t row_bytes, size_t rows, size_t slices,
+                                   uint64_t max_bytes);
+    // Between the host block and a mapped view with its own pitches.
+    void pack(const uint8_t* mapped, size_t row_pitch, size_t depth_pitch);
+    void unpack(uint8_t* mapped, size_t row_pitch, size_t depth_pitch) const;
+
+    uint8_t* host_data() { return m_host.data(); }
+    size_t host_size() const { return m_host.size(); }
+    size_t row_pitch() const { return m_row_bytes; }
+    size_t slice_pitch() const { return m_row_bytes * m_rows; }
+
+private:
+    friend struct cvk_interop_device;
+    cvk_interop_device* m_device;
+    void* m_external;
+    uint32_t m_subresource;
+    bool m_acquired = false;
+    std::vector<uint8_t> m_host;
+    size_t m_row_bytes = 0;
+    size_t m_rows = 0;
+    size_t m_slices = 0;
+};
+
+// The checks every create-from call starts with: the context, then the flags.
+CHECK_RETURN cl_int cvk_interop_check_create(cl_context context,
+                                             cl_mem_flags flags);
+// A memory object for an external object; the object is attached to it. On
+// failure the object is destroyed and nullptr returned.
+cl_mem cvk_interop_create_buffer(cl_context context, cl_mem_flags flags,
+                                 size_t size,
+                                 std::unique_ptr<cvk_interop_object> object,
+                                 cl_int* errcode_ret);
+cl_mem cvk_interop_create_image(cl_context context, cl_mem_flags flags,
+                                const cl_image_format& format,
+                                const cl_image_desc& desc,
+                                std::unique_ptr<cvk_interop_object> object,
+                                cl_int* errcode_ret);
+void cvk_interop_set_error(cl_int* errcode_ret, cl_int err);
+// The largest host block a memory object of the context can have.
+uint64_t cvk_interop_max_bytes(cl_context context);
+
+// One per context that names an external device.
+struct cvk_interop_device {
+    explicit cvk_interop_device(cvk_interop_api api) : m_api(api) {}
+    virtual ~cvk_interop_device() = default;
+
+    cvk_interop_api api() const { return m_api; }
+
+    virtual cl_command_type acquire_command() const = 0;
+    virtual cl_command_type release_command() const = 0;
+    // For a memory object that does not come from this API.
+    virtual cl_int foreign_object_error() const = 0;
+    // For an acquire or release that would not change an object's state;
+    // CL_SUCCESS when the API defines no error for it.
+    virtual cl_int already_acquired_error() const = 0;
+    virtual cl_int not_acquired_error() const = 0;
+
+    // Every object moves through the host block, whether the external
+    // object is shared or not.
+    bool prefers_shared_resources() const { return false; }
+
+    // The objects of one acquire or release, in list order. The default runs
+    // them on the calling thread.
+    CHECK_RETURN virtual cl_int
+    capture(const std::vector<cvk_interop_object*>& objects);
+    CHECK_RETURN virtual cl_int
+    publish(const std::vector<cvk_interop_object*>& objects);
+
+    // False when this subresource of the external object already has a
+    // memory object.
+    bool add_wrapped(void* external, uint32_t subresource);
+    void remove_wrapped(void* external, uint32_t subresource);
+
+    // Sets the objects' state. An object moves only when its state changes;
+    // moves[i] says whether objects[i] does. An API with errors for a call
+    // that changes nothing fails the whole call before any object changes.
+    CHECK_RETURN cl_int mark(const std::vector<cvk_interop_object*>& objects,
+                             bool acquire, std::vector<bool>* moves);
+    void unmark(const std::vector<cvk_interop_object*>& objects,
+                const std::vector<bool>& moves, bool acquired);
+
+    void report_user_event_wait();
+
+private:
+    cvk_interop_api m_api;
+    std::mutex m_lock;
+    std::set<std::pair<void*, uint32_t>> m_wrapped;
+    bool m_reported_user_event = false;
+};
