+struct dxgi_image_format {
+    DXGI_FORMAT dxgi;
+    cl_channel_order order;
+    cl_channel_type type;
+    size_t element_size;
+};
+
+// cl_khr_d3d10_sharing, "Direct3D 10 formats and corresponding OpenCL image
+// formats".
+const dxgi_image_format formats[] = {
+    {DXGI_FORMAT_R32G32B32A32_FLOAT, CL_RGBA, CL_FLOAT, 16},
+    {DXGI_FORMAT_R32G32B32A32_UINT, CL_RGBA, CL_UNSIGNED_INT32, 16},
