+template <typename T> bool resolve(FARPROC proc, T* entry) {
+    *entry = reinterpret_cast<T>(proc);
+    return proc != nullptr;
+}
+
+bool resolve_api(HMODULE opengl32, HMODULE icd, gl_api* api) {
+    using get_proc_t = PROC(WINAPI*)(LPCSTR);
+    auto get =
+        reinterpret_cast<get_proc_t>(GetProcAddress(icd, "DrvGetProcAddress"));
+    if (get == nullptr) {
+        return false;
+    }
+    return resolve(GetProcAddress(opengl32, "wglMakeCurrent"),
+                   &api->make_current) &&
+           resolve(GetProcAddress(opengl32, "wglDeleteContext"),
+                   &api->delete_context) &&
+           resolve(get("wglCreatePbufferARB"), &api->create_pbuffer) &&
+           resolve(get("wglGetPbufferDCARB"), &api->get_pbuffer_dc) &&
+           resolve(get("wglDestroyPbufferARB"), &api->destroy_pbuffer) &&
+           resolve(get("wglCreateContextAttribsARB"),
+                   &api->create_context_attribs) &&
+           resolve(get("wglMesaGLInteropQueryDeviceInfo"),
+                   &api->query_device_info) &&
+           resolve(get("glGetIntegerv"), &api->get_integer) &&
+           resolve(get("glGetStringi"), &api->get_string_i) &&
+           resolve(get("glPixelStorei"), &api->pixel_store) &&
+           resolve(get("glFinish"), &api->finish) &&
+           resolve(get("glGetNamedBufferParameteri64v"),
+                   &api->get_buffer_size) &&
+           resolve(get("glGetNamedBufferSubData"), &api->get_buffer_data) &&
+           resolve(get("glNamedBufferSubData"), &api->set_buffer_data) &&
+           resolve(get("glGetTextureParameteriv"),
+                   &api->get_texture_parameter) &&
+           resolve(get("glGetTextureLevelParameteriv"),
+                   &api->get_texture_level_parameter) &&
+           resolve(get("glGetTextureSubImage"), &api->get_texture_image) &&
+           resolve(get("glTextureSubImage1D"), &api->set_texture_image_1d) &&
+           resolve(get("glTextureSubImage2D"), &api->set_texture_image_2d) &&
+           resolve(get("glTextureSubImage3D"), &api->set_texture_image_3d) &&
+           resolve(get("glGetNamedRenderbufferParameteriv"),
+                   &api->get_renderbuffer_parameter) &&
+           resolve(get("glCreateTextures"), &api->create_textures) &&
+           resolve(get("glTextureStorage2D"), &api->texture_storage_2d) &&
+           resolve(get("glDeleteTextures"), &api->delete_textures) &&
+           resolve(get("glCopyImageSubData"), &api->copy_image);
+}
+
+const gl_api* load_api(HDC hdc) {
+    static std::mutex lock;
+    static const gl_api* loaded = nullptr;
+    std::lock_guard<std::mutex> guard(lock);
+    if (loaded != nullptr) {
+        return loaded;
+    }
+    std::wstring icd_name;
+    HMODULE icd = nullptr;
+    HMODULE opengl32 = nullptr;
+    if (!cvk_kmt_opengl_icd(hdc, &icd_name) ||
+        !GetModuleHandleExW(0, icd_name.c_str(), &icd)) {
+        return nullptr;
+    }
+    auto api = std::make_unique<gl_api>();
+    if (!GetModuleHandleExW(0, L"opengl32.dll", &opengl32) ||
+        !resolve_api(opengl32, icd, api.get())) {
+        if (opengl32 != nullptr) {
+            FreeLibrary(opengl32);
+        }
+        FreeLibrary(icd);
+        return nullptr;
+    }
+    loaded = api.release();
+    return loaded;
+}
+
+// The current context has the calls the worker makes: GL 4.5, or the
+// extensions that bring them.
+bool has_transfer_calls(const gl_api& gl) {
+    GLint major = 0, minor = 0;
+    gl.get_integer(GL_MAJOR_VERSION, &major);
+    gl.get_integer(GL_MINOR_VERSION, &minor);
+    if (major > 4 || (major == 4 && minor >= 5)) {
+        return true;
+    }
+    static const char* const needed[] = {"GL_ARB_direct_state_access",
+                                         "GL_ARB_get_texture_sub_image",
+                                         "GL_ARB_copy_image"};
+    bool found[3] = {};
+    GLint count = 0;
+    gl.get_integer(GL_NUM_EXTENSIONS, &count);
+    for (GLint i = 0; i < count; i++) {
+        auto name = reinterpret_cast<const char*>(
+            gl.get_string_i(GL_EXTENSIONS, static_cast<GLuint>(i)));
+        for (size_t n = 0; name != nullptr && n < 3; n++) {
+            found[n] = found[n] || strcmp(name, needed[n]) == 0;
+        }
+    }
+    return found[0] && found[1] && found[2];
+}
+
+cl_int query_device_uuid(HDC hdc, HGLRC context, uint8_t* uuid) {
+    const gl_api* api =
+        hdc != nullptr && context != nullptr ? load_api(hdc) : nullptr;
+    if (api == nullptr) {
+        return CL_INVALID_GL_SHAREGROUP_REFERENCE_KHR;
+    }
+    mesa_glinterop_device_info info = {};
+    info.version = 3;
+    if (api->query_device_info(hdc, context, &info) != 0 || info.version < 3) {
+        return CL_INVALID_GL_SHAREGROUP_REFERENCE_KHR;
+    }
+    memcpy(uuid, info.device_uuid, CL_UUID_SIZE_KHR);
+    return CL_SUCCESS;
+}
+
+// One thread per process makes every GL call of every CL context. It owns a
+// 1x1 pbuffer to make its contexts current on, keeps the last context
+// current, and dispatches its messages between requests, so a message sent
+// to every top-level window does not stall on it. It lives until the
+// process exits, as the command queue executors do.
+class gl_worker {
+public:
+    static gl_worker* get(const gl_api* api, HDC hdc, int pixel_format) {
+        static std::mutex lock;
+        static gl_worker* started = nullptr;
+        std::lock_guard<std::mutex> guard(lock);
+        if (started == nullptr) {
+            auto worker = std::make_unique<gl_worker>(api);
+            if (worker->start(hdc, pixel_format)) {
+                started = worker.release();
+            }
+        }
+        return started;
+    }
+
+    explicit gl_worker(const gl_api* api) : m_api(api) {}
+
+    const gl_api& api() const { return *m_api; }
+
+    // Runs work with context current; with no context, as it is.
+    cl_int run(HGLRC context, const std::function<cl_int()>& work) {
+        request job{context, &work};
+        std::unique_lock<std::mutex> lock(m_lock);
+        m_queue.push_back(&job);
+        SetEvent(m_wake);
+        m_done.wait(lock, [&job] { return job.done; });
+        return job.result;
+    }
+
+    cl_int create_context(HGLRC share, HGLRC* created) {
+        return run(nullptr, [&]() -> cl_int {
+            // GL_TEXTURE_TARGET is a core profile query.
+            static const int attributes[] = {WGL_CONTEXT_MAJOR_VERSION_ARB,
+                                             3,
+                                             WGL_CONTEXT_MINOR_VERSION_ARB,
+                                             2,
+                                             WGL_CONTEXT_PROFILE_MASK_ARB,
+                                             WGL_CONTEXT_CORE_PROFILE_BIT_ARB,
+                                             0};
+            HGLRC context =
+                m_api->create_context_attribs(m_dc, share, attributes);
+            if (context == nullptr) {
+                return CL_INVALID_GL_SHAREGROUP_REFERENCE_KHR;
+            }
+            if (!m_api->make_current(m_dc, context)) {
+                m_current = nullptr;
+                m_api->delete_context(context);
+                return CL_INVALID_GL_SHAREGROUP_REFERENCE_KHR;
+            }
+            m_current = context;
+            if (!has_transfer_calls(*m_api)) {
+                m_api->make_current(nullptr, nullptr);
+                m_current = nullptr;
+                m_api->delete_context(context);
+                return CL_INVALID_GL_SHAREGROUP_REFERENCE_KHR;
+            }
+            m_api->pixel_store(GL_PACK_ALIGNMENT, 1);
+            m_api->pixel_store(GL_UNPACK_ALIGNMENT, 1);
+            *created = context;
+            return CL_SUCCESS;
+        });
+    }
+
+    void destroy_context(HGLRC context) {
+        cl_int err = run(nullptr, [&]() -> cl_int {
+            if (m_current == context) {
+                m_api->make_current(nullptr, nullptr);
+                m_current = nullptr;
+            }
+            m_api->delete_context(context);
+            return CL_SUCCESS;
+        });
+        UNUSED(err);
+    }
+
+private:
+    struct request {
+        HGLRC context;
+        const std::function<cl_int()>* work;
+        cl_int result = CL_SUCCESS;
+        bool done = false;
+    };
+
+    bool start(HDC hdc, int pixel_format) {
+        m_wake = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+        if (m_wake == nullptr) {
+            return false;
+        }
+        std::thread thread(
+            [this, hdc, pixel_format] { main(hdc, pixel_format); });
+        std::unique_lock<std::mutex> lock(m_lock);
+        m_done.wait(lock, [this] { return m_state != state::starting; });
+        if (m_state == state::failed) {
+            lock.unlock();
+            thread.join();
+            CloseHandle(m_wake);
+            return false;
+        }
+        thread.detach();
+        return true;
+    }
+
+    void main(HDC hdc, int pixel_format) {
+        HANDLE pbuffer =
+            m_api->create_pbuffer(hdc, pixel_format, 1, 1, nullptr);
+        if (pbuffer != nullptr) {
+            m_dc = m_api->get_pbuffer_dc(pbuffer);
+            if (m_dc == nullptr) {
+                m_api->destroy_pbuffer(pbuffer);
+            }
+        }
+        {
+            std::lock_guard<std::mutex> lock(m_lock);
+            m_state = m_dc != nullptr ? state::running : state::failed;
+        }
+        m_done.notify_all();
+        if (m_dc == nullptr) {
+            return;
+        }
+
+        for (;;) {
+            MsgWaitForMultipleObjectsEx(1, &m_wake, INFINITE, QS_ALLINPUT,
+                                        MWMO_INPUTAVAILABLE);
+            MSG message;
+            while (PeekMessageW(&message, nullptr, 0, 0, PM_REMOVE)) {
+                TranslateMessage(&message);
+                DispatchMessageW(&message);
+            }
+            for (;;) {
+                request* job;
+                {
+                    std::lock_guard<std::mutex> lock(m_lock);
+                    if (m_queue.empty()) {
+                        break;
+                    }
+                    job = m_queue.front();
+                    m_queue.pop_front();
+                }
+                cl_int result = execute(*job);
+                {
+                    std::lock_guard<std::mutex> lock(m_lock);
+                    job->result = result;
+                    job->done = true;
+                }
+                m_done.notify_all();
+            }
+        }
+    }
+
+    cl_int execute(const request& job) {
+        if (job.context != nullptr && job.context != m_current) {
+            if (!m_api->make_current(m_dc, job.context)) {
+                m_current = nullptr;
+                return CL_OUT_OF_RESOURCES;
+            }
+            m_current = job.context;
+        }
+        return (*job.work)();
+    }
+
+    enum class state
+    {
+        starting,
+        running,
+        failed
+    };
+
+    const gl_api* m_api;
+    HANDLE m_wake = nullptr;
+    HDC m_dc = nullptr;
+    HGLRC m_current = nullptr;
+    std::mutex m_lock;
+    std::condition_variable m_done;
+    std::deque<request*> m_queue;
+    state m_state = state::starting;
+};
+
+struct cvk_gl_interop final : public cvk_interop_device {
+    cvk_gl_interop(gl_worker* worker, HGLRC context)
+        : cvk_interop_device(cvk_interop_api::gl), m_worker(worker),
+          m_context(context) {}
+    ~cvk_gl_interop() override { m_worker->destroy_context(m_context); }
+
+    cl_command_type acquire_command() const override {
+        return CL_COMMAND_ACQUIRE_GL_OBJECTS;
+    }
+    cl_command_type release_command() const override {
+        return CL_COMMAND_RELEASE_GL_OBJECTS;
+    }
+    cl_int foreign_object_error() const override {
+        return CL_INVALID_GL_OBJECT;
+    }
+    cl_int already_acquired_error() const override { return CL_SUCCESS; }
+    cl_int not_acquired_error() const override { return CL_SUCCESS; }
+
+    cl_int capture(const std::vector<cvk_interop_object*>& objects) override {
+        return run(
+            [&]() -> cl_int { return cvk_interop_device::capture(objects); });
+    }
+
+    cl_int publish(const std::vector<cvk_interop_object*>& objects) override {
+        return run([&]() -> cl_int {
+            cl_int status = cvk_interop_device::publish(objects);
+            api().finish();
+            return status;
+        });
+    }
+
+    cl_int run(const std::function<cl_int()>& work) {
+        return m_worker->run(m_context, work);
+    }
+
+    const gl_api& api() const { return m_worker->api(); }
+
+private:
+    gl_worker* m_worker;
+    HGLRC m_context;
+};
+
+// What a GL object looks like when its CL memory object is made. Every later
+// transfer is bounded by it, whatever the application does to the GL object.
+struct gl_shape {
+    cl_gl_object_type type = 0;
+    const gl_format* format = nullptr;
+    uint64_t buffer_size = 0;
+    GLsizei width = 1;
+    GLsizei height = 1;
+    GLsizei depth = 1;
+    GLint zoffset = 0;
+    GLuint transfer = 0;
+};
+
+// One GL object, or one level or cube face of a texture. A renderbuffer
+// moves through a texture of the same format, since GL reads and writes
+// images only of textures.
+struct cvk_gl_object final : public cvk_interop_object {
+    cvk_gl_object(cvk_gl_interop* device, GLuint name, GLenum target,
+                  GLint level, const gl_shape& shape)
+        : cvk_interop_object(device, reinterpret_cast<void*>(uintptr_t(name)),
+                             static_cast<uint32_t>(level)),
+          m_gl(device), m_name(name), m_target(target), m_level(level),
+          m_shape(shape) {}
+
+    ~cvk_gl_object() override {
+        if (m_shape.transfer != 0) {
+            GLuint transfer = m_shape.transfer;
+            cl_int err = m_gl->run([&]() -> cl_int {
+                m_gl->api().delete_textures(1, &transfer);
+                return CL_SUCCESS;
+            });
+            UNUSED(err);
+        }
+    }
+
+    cl_int capture() override {
+        const gl_api& gl = m_gl->api();
+        switch (m_shape.type) {
+        case CL_GL_OBJECT_BUFFER:
+            gl.get_buffer_data(m_name, 0, static_cast<GLsizeiptr>(host_size()),
+                               host_data());
+            break;
+        case CL_GL_OBJECT_RENDERBUFFER:
+            gl.copy_image(m_name, GL_RENDERBUFFER, 0, 0, 0, 0, m_shape.transfer,
+                          GL_TEXTURE_2D, 0, 0, 0, 0, m_shape.width,
+                          m_shape.height, 1);
+            read(m_shape.transfer, 0);
+            break;
+        default:
+            read(m_name, m_level);
+            break;
+        }
+        return CL_SUCCESS;
+    }
+
+    cl_int publish() override {
+        const gl_api& gl = m_gl->api();
+        switch (m_shape.type) {
+        case CL_GL_OBJECT_BUFFER:
+            gl.set_buffer_data(m_name, 0, static_cast<GLsizeiptr>(host_size()),
+                               host_data());
+            break;
+        case CL_GL_OBJECT_RENDERBUFFER:
+            write(m_shape.transfer, 0);
+            gl.copy_image(m_shape.transfer, GL_TEXTURE_2D, 0, 0, 0, 0, m_name,
+                          GL_RENDERBUFFER, 0, 0, 0, 0, m_shape.width,
+                          m_shape.height, 1);
+            break;
+        default:
+            write(m_name, m_level);
+            break;
+        }
+        return CL_SUCCESS;
+    }
+
+    cl_gl_object_type type() const { return m_shape.type; }
+    GLuint name() const { return m_name; }
+    GLenum target() const { return m_target; }
+    GLint level() const { return m_level; }
+
+private:
+    void read(GLuint texture, GLint level) {
+        m_gl->api().get_texture_image(
+            texture, level, 0, 0, m_shape.zoffset, m_shape.width,
+            m_shape.height, m_shape.depth, m_shape.format->format,
+            m_shape.format->data_type, static_cast<GLsizei>(host_size()),
+            host_data());
+    }
+
+    void write(GLuint texture, GLint level) {
+        const gl_api& gl = m_gl->api();
+        const gl_format& format = *m_shape.format;
+        switch (m_shape.type) {
+        case CL_GL_OBJECT_TEXTURE1D:
+            gl.set_texture_image_1d(texture, level, 0, m_shape.width,
+                                    format.format, format.data_type,
+                                    host_data());
+            break;
+        case CL_GL_OBJECT_TEXTURE2D_ARRAY:
+        case CL_GL_OBJECT_TEXTURE3D:
+            write_layers(texture, level);
+            break;
+        default:
+            // A cube map face is a layer of the texture.
+            if (is_cube_face(m_target)) {
+                write_layers(texture, level);
+                break;
+            }
+            gl.set_texture_image_2d(texture, level, 0, 0, m_shape.width,
+                                    m_shape.height, format.format,
+                                    format.data_type, host_data());
+            break;
+        }
+    }
+
+    void write_layers(GLuint texture, GLint level) {
+        const gl_format& format = *m_shape.format;
+        m_gl->api().set_texture_image_3d(texture, level, 0, 0, m_shape.zoffset,
+                                         m_shape.width, m_shape.height,
+                                         m_shape.depth, format.format,
+                                         format.data_type, host_data());
+    }
+
+    cvk_gl_interop* m_gl;
+    GLuint m_name;
+    GLenum m_target;
+    GLint m_level;
+    gl_shape m_shape;
+};
+
+cl_gl_object_type texture_object_type(GLenum target) {
+    switch (target) {
+    case GL_TEXTURE_1D:
+        return CL_GL_OBJECT_TEXTURE1D;
+    case GL_TEXTURE_1D_ARRAY:
+        return CL_GL_OBJECT_TEXTURE1D_ARRAY;
+    case GL_TEXTURE_2D:
+    case GL_TEXTURE_RECTANGLE:
+        return CL_GL_OBJECT_TEXTURE2D;
+    case GL_TEXTURE_2D_ARRAY:
+        return CL_GL_OBJECT_TEXTURE2D_ARRAY;
+    case GL_TEXTURE_3D:
+        return CL_GL_OBJECT_TEXTURE3D;
+    case GL_TEXTURE_BUFFER:
+        return CL_GL_OBJECT_TEXTURE_BUFFER;
+    default:
+        return is_cube_face(target) ? CL_GL_OBJECT_TEXTURE2D : 0;
+    }
+}
+
+cvk_gl_interop* gl_interop_of(cl_context context) {
+    auto interop = icd_downcast(context)->interop();
+    if (interop == nullptr || interop->api() != cvk_interop_api::gl) {
+        return nullptr;
+    }
+    return static_cast<cvk_gl_interop*>(interop);
+}
+
+cvk_gl_object* gl_object_of(cl_mem mem) {
+    auto object = icd_downcast(mem)->interop();
+    if (object == nullptr || object->device()->api() != cvk_interop_api::gl) {
+        return nullptr;
+    }
+    return static_cast<cvk_gl_object*>(object);
+}
+
+// The context checks come first for GL, then the flags.
+cl_int check_create(cl_context context, cl_mem_flags flags,
+                    cvk_gl_interop** device) {
+    if (!is_valid_context(context) || gl_interop_of(context) == nullptr) {
+        return CL_INVALID_CONTEXT;
+    }
+    *device = gl_interop_of(context);
+    return cvk_interop_check_create(context, flags);
+}
+
+cl_int describe_buffer(const gl_api& gl, GLuint buffer, gl_shape* shape) {
+    GLint64 size = 0;
+    gl.get_buffer_size(buffer, GL_BUFFER_SIZE, &size);
+    if (size <= 0) {
+        return CL_INVALID_GL_OBJECT;
+    }
+    shape->type = CL_GL_OBJECT_BUFFER;
+    shape->buffer_size = static_cast<uint64_t>(size);
+    return CL_SUCCESS;
+}
+
+// q of the texture completeness rules: the last level of a full mipmap
+// chain from the base level, and no more than the maximum level.
+GLint last_level(const gl_api& gl, GLenum target, GLuint texture, GLint base,
+                 GLint max_level) {
+    if (target == GL_TEXTURE_RECTANGLE) {
+        return base;
+    }
+    GLint width = 0, height = 0, depth = 0;
+    gl.get_texture_level_parameter(texture, base, GL_TEXTURE_WIDTH, &width);
+    gl.get_texture_level_parameter(texture, base, GL_TEXTURE_HEIGHT, &height);
+    gl.get_texture_level_parameter(texture, base, GL_TEXTURE_DEPTH, &depth);
+    GLint size = width;
+    if (target != GL_TEXTURE_1D && target != GL_TEXTURE_1D_ARRAY) {
+        size = std::max(size, height);
+    }
+    if (target == GL_TEXTURE_3D) {
+        size = std::max(size, depth);
+    }
+    GLint levels = 0;
+    while (size > 1) {
+        size >>= 1;
+        levels++;
+    }
+    return std::min(base + levels, max_level);
+}
+
+cl_int describe_texture(const gl_api& gl, GLenum target, GLint level,
+                        GLuint texture, gl_shape* shape) {
+    GLint actual = 0;
+    gl.get_texture_parameter(texture, GL_TEXTURE_TARGET, &actual);
+    GLenum expected = is_cube_face(target) ? GL_TEXTURE_CUBE_MAP : target;
+    if (texture == 0 || static_cast<GLenum>(actual) != expected) {
+        return CL_INVALID_GL_OBJECT;
+    }
+    GLint base = 0, max_level = 0;
+    gl.get_texture_parameter(texture, GL_TEXTURE_BASE_LEVEL, &base);
+    gl.get_texture_parameter(texture, GL_TEXTURE_MAX_LEVEL, &max_level);
+    if (level < 0 || level < base ||
+        level > last_level(gl, target, texture, base, max_level)) {
+        return CL_INVALID_MIP_LEVEL;
+    }
+    GLint width = 0, height = 0, depth = 0, internal_format = 0;
+    gl.get_texture_level_parameter(texture, level, GL_TEXTURE_WIDTH, &width);
+    gl.get_texture_level_parameter(texture, level, GL_TEXTURE_HEIGHT, &height);
+    gl.get_texture_level_parameter(texture, level, GL_TEXTURE_DEPTH, &depth);
+    gl.get_texture_level_parameter(texture, level, GL_TEXTURE_INTERNAL_FORMAT,
+                                   &internal_format);
+    if (width <= 0 || height <= 0 || depth <= 0) {
+        return CL_INVALID_GL_OBJECT;
+    }
+    shape->format = find_format(internal_format);
+    if (shape->format == nullptr) {
+        return CL_INVALID_IMAGE_FORMAT_DESCRIPTOR;
+    }
+    if (target == GL_TEXTURE_BUFFER) {
+        return CL_INVALID_OPERATION;
+    }
+    shape->type = texture_object_type(target);
+    shape->width = width;
+    shape->height = height;
+    shape->depth = depth;
+    if (is_cube_face(target)) {
+        shape->zoffset =
+            static_cast<GLint>(target - GL_TEXTURE_CUBE_MAP_POSITIVE_X);
+        shape->depth = 1;
+    }
+    return CL_SUCCESS;
+}
+
+cl_int describe_renderbuffer(const gl_api& gl, GLuint renderbuffer,
+                             gl_shape* shape) {
+    GLint width = 0, height = 0, internal_format = 0, samples = 0;
+    gl.get_renderbuffer_parameter(renderbuffer, GL_RENDERBUFFER_WIDTH, &width);
+    gl.get_renderbuffer_parameter(renderbuffer, GL_RENDERBUFFER_HEIGHT,
+                                  &height);
+    gl.get_renderbuffer_parameter(renderbuffer, GL_RENDERBUFFER_INTERNAL_FORMAT,
+                                  &internal_format);
+    gl.get_renderbuffer_parameter(renderbuffer, GL_RENDERBUFFER_SAMPLES,
+                                  &samples);
+    if (renderbuffer == 0 || width <= 0 || height <= 0) {
+        return CL_INVALID_GL_OBJECT;
+    }
+    shape->format = find_format(internal_format);
+    if (shape->format == nullptr) {
+        return CL_INVALID_IMAGE_FORMAT_DESCRIPTOR;
+    }
+    if (samples > 0) {
+        return CL_INVALID_OPERATION;
+    }
+    GLuint transfer = 0;
+    gl.create_textures(GL_TEXTURE_2D, 1, &transfer);
+    if (transfer == 0) {
+        return CL_OUT_OF_RESOURCES;
+    }
+    gl.texture_storage_2d(transfer, 1, shape->format->storage_format, width,
+                          height);
+    shape->type = CL_GL_OBJECT_RENDERBUFFER;
+    shape->width = width;
+    shape->height = height;
+    shape->transfer = transfer;
+    return CL_SUCCESS;
+}
+
+cl_mem create_image(cl_context context, cl_mem_flags flags,
+                    cvk_gl_interop* device, GLuint name, GLenum target,
+                    GLint level, const gl_shape& shape, cl_int* errcode_ret) {
+    auto object =
+        std::make_unique<cvk_gl_object>(device, name, target, level, shape);
+    // A texture transfer gives GL its size as a GLsizei.
+    uint64_t limit =
+        std::min<uint64_t>(cvk_interop_max_bytes(context), INT_MAX);
+    size_t row_bytes = size_t(shape.width) * shape.format->element_size;
+    cl_image_desc desc = {};
+    desc.image_width = shape.width;
+    cl_int err;
+    switch (shape.type) {
+    case CL_GL_OBJECT_TEXTURE1D:
+        desc.image_type = CL_MEM_OBJECT_IMAGE1D;
+        err = object->set_layout(row_bytes, 1, 1, limit);
+        break;
+    case CL_GL_OBJECT_TEXTURE1D_ARRAY:
+        desc.image_type = CL_MEM_OBJECT_IMAGE1D_ARRAY;
+        desc.image_array_size = shape.height;
+        err = object->set_layout(row_bytes, 1, shape.height, limit);
+        break;
+    case CL_GL_OBJECT_TEXTURE2D_ARRAY:
+        desc.image_type = CL_MEM_OBJECT_IMAGE2D_ARRAY;
+        desc.image_height = shape.height;
+        desc.image_array_size = shape.depth;
+        err = object->set_layout(row_bytes, shape.height, shape.depth, limit);
+        break;
+    case CL_GL_OBJECT_TEXTURE3D:
+        desc.image_type = CL_MEM_OBJECT_IMAGE3D;
+        desc.image_height = shape.height;
+        desc.image_depth = shape.depth;
+        err = object->set_layout(row_bytes, shape.height, shape.depth, limit);
+        break;
+    default:
+        desc.image_type = CL_MEM_OBJECT_IMAGE2D;
+        desc.image_height = shape.height;
+        err = object->set_layout(row_bytes, shape.height, 1, limit);
+        break;
+    }
+    if (err != CL_SUCCESS) {
+        cvk_interop_set_error(errcode_ret, err);
+        return nullptr;
+    }
+    cl_image_format format = {shape.format->order, shape.format->type};
+    return cvk_interop_create_image(context, flags, format, desc,
+                                    std::move(object), errcode_ret);
+}
+
+cl_mem create_from_texture(cl_context context, cl_mem_flags flags,
+                           GLenum target, GLint level, GLuint texture,
+                           cl_int* errcode_ret) {
+    cvk_gl_interop* device = nullptr;
+    cl_int err = check_create(context, flags, &device);
+    if (err == CL_SUCCESS && texture_object_type(target) == 0) {
+        err = CL_INVALID_VALUE;
+    }
+    gl_shape shape;
+    if (err == CL_SUCCESS) {
+        err = device->run([&] {
+            return describe_texture(device->api(), target, level, texture,
+                                    &shape);
+        });
+    }
+    if (err != CL_SUCCESS) {
+        cvk_interop_set_error(errcode_ret, err);
+        return nullptr;
+    }
+    return create_image(context, flags, device, texture, target, level, shape,
+                        errcode_ret);
+}
+
+struct gl_binding {
+    cl_platform_id platform = nullptr;
+    HGLRC context = nullptr;
+    HDC hdc = nullptr;
+};
+
+// WGL is the only window-system binding on Windows.
+cl_int read_gl_binding(const cl_context_properties* properties,
+                       gl_binding* binding) {
+    for (auto property = properties; property[0] != 0; property += 2) {
+        switch (property[0]) {
+        case CL_CONTEXT_PLATFORM:
+            binding->platform = reinterpret_cast<cl_platform_id>(property[1]);
+            break;
+        case CL_GL_CONTEXT_KHR:
+            binding->context = reinterpret_cast<HGLRC>(property[1]);
+            break;
+        case CL_WGL_HDC_KHR:
+            binding->hdc = reinterpret_cast<HDC>(property[1]);
+            break;
+        case CL_EGL_DISPLAY_KHR:
+        case CL_GLX_DISPLAY_KHR:
+        case CL_CGL_SHAREGROUP_KHR:
+            if (property[1] != 0) {
+                return CL_INVALID_OPERATION;
+            }
+            break;
+        default:
+            break;
+        }
+    }
+    return CL_SUCCESS;
+}
+
+} // namespace
+
+cl_int cvk_create_gl_interop(cvk_device* device,
+                             const cl_context_properties* properties,
+                             cvk_interop_device** created) {
+    gl_binding binding;
+    cl_int err = read_gl_binding(properties, &binding);
+    if (err != CL_SUCCESS || binding.context == nullptr) {
+        return err;
+    }
+    HDC hdc = binding.hdc;
+    uint8_t uuid[CL_UUID_SIZE_KHR];
+    err = query_device_uuid(hdc, binding.context, uuid);
+    if (err != CL_SUCCESS) {
+        return err;
+    }
+    int pixel_format = GetPixelFormat(hdc);
+    if (memcmp(device->uuid(), uuid, CL_UUID_SIZE_KHR) != 0 ||
+        pixel_format <= 0) {
+        return CL_INVALID_GL_SHAREGROUP_REFERENCE_KHR;
+    }
+    gl_worker* worker = gl_worker::get(load_api(hdc), hdc, pixel_format);
+    if (worker == nullptr) {
+        return CL_INVALID_GL_SHAREGROUP_REFERENCE_KHR;
+    }
+    HGLRC own = nullptr;
+    err = worker->create_context(binding.context, &own);
+    if (err != CL_SUCCESS) {
+        return err;
+    }
+    *created = new cvk_gl_interop(worker, own);
+    return CL_SUCCESS;
+}
+
+cl_int CLVK_API_CALL clGetGLContextInfoKHR(
+    const cl_context_properties* properties, cl_gl_context_info param_name,
+    size_t param_value_size, void* param_value, size_t* param_value_size_ret) {
+    if (properties == nullptr) {
+        return CL_INVALID_GL_SHAREGROUP_REFERENCE_KHR;
+    }
+    for (auto property = properties; property[0] != 0; property += 2) {
+        if (property[0] != CL_CONTEXT_PLATFORM &&
+            property[0] != CL_CONTEXT_INTEROP_USER_SYNC &&
+            !cvk_is_interop_context_property(property[0])) {
+            return CL_INVALID_VALUE;
+        }
+    }
+    bool named;
+    cvk_interop_api api;
+    gl_binding binding;
+    cl_int err = cvk_interop_named_api(properties, &named, &api);
+    if (err == CL_SUCCESS) {
+        err = read_gl_binding(properties, &binding);
+    }
+    if (err != CL_SUCCESS) {
+        return err;
+    }
+    cl_platform_id platform = binding.platform;
+    if (platform != nullptr && !is_valid_platform(platform)) {
+        return CL_INVALID_PLATFORM;
+    }
+    if (param_name != CL_CURRENT_DEVICE_FOR_GL_CONTEXT_KHR &&
+        param_name != CL_DEVICES_FOR_GL_CONTEXT_KHR) {
+        return CL_INVALID_VALUE;
+    }
+    uint8_t uuid[CL_UUID_SIZE_KHR];
+    err = query_device_uuid(binding.hdc, binding.context, uuid);
+    if (err != CL_SUCCESS) {
+        return err;
+    }
+
+    const cvk_platform* plat = platform != nullptr
+                                   ? icd_downcast(platform)
+                                   : get_or_init_global_state()->platform();
+    auto found = plat->devices_with_uuid(uuid);
+    if (param_name == CL_CURRENT_DEVICE_FOR_GL_CONTEXT_KHR &&
+        found.size() > 1) {
+        found.resize(1);
+    }
+    size_t size = found.size() * sizeof(cl_device_id);
+    if (param_value != nullptr && param_value_size < size) {
+        return CL_INVALID_VALUE;
+    }
+    if (param_value != nullptr) {
+        for (size_t i = 0; i < found.size(); i++) {
+            static_cast<cl_device_id*>(param_value)[i] = found[i];
+        }
+    }
+    if (param_value_size_ret != nullptr) {
+        *param_value_size_ret = size;
+    }
+    return CL_SUCCESS;
+}
+
+cl_mem CLVK_API_CALL clCreateFromGLBuffer(cl_context context,
+                                          cl_mem_flags flags, cl_GLuint bufobj,
+                                          cl_int* errcode_ret) {
+    cvk_gl_interop* device = nullptr;
+    cl_int err = check_create(context, flags, &device);
+    gl_shape shape;
+    if (err == CL_SUCCESS) {
+        err = device->run(
+            [&] { return describe_buffer(device->api(), bufobj, &shape); });
+    }
+    if (err != CL_SUCCESS) {
+        cvk_interop_set_error(errcode_ret, err);
+        return nullptr;
+    }
+    auto object = std::make_unique<cvk_gl_object>(device, bufobj, 0, 0, shape);
+    uint64_t limit =
+        std::min<uint64_t>(cvk_interop_max_bytes(context), INTPTR_MAX);
+    if (shape.buffer_size > limit) {
+        cvk_interop_set_error(errcode_ret, CL_OUT_OF_RESOURCES);
+        return nullptr;
+    }
+    err =
+        object->set_layout(static_cast<size_t>(shape.buffer_size), 1, 1, limit);
+    if (err != CL_SUCCESS) {
+        cvk_interop_set_error(errcode_ret, err);
+        return nullptr;
+    }
+    return cvk_interop_create_buffer(context, flags,
+                                     static_cast<size_t>(shape.buffer_size),
+                                     std::move(object), errcode_ret);
+}
+
+cl_mem CLVK_API_CALL clCreateFromGLTexture(cl_context context,
+                                           cl_mem_flags flags,
+                                           cl_GLenum texture_target,
+                                           cl_GLint miplevel, cl_GLuint texture,
+                                           cl_int* errcode_ret) {
+    return create_from_texture(context, flags, texture_target, miplevel,
+                               texture, errcode_ret);
+}
+
+cl_mem CLVK_API_CALL clCreateFromGLTexture2D(
+    cl_context context, cl_mem_flags flags, cl_GLenum texture_target,
+    cl_GLint miplevel, cl_GLuint texture, cl_int* errcode_ret) {
+    if (texture_target != GL_TEXTURE_2D &&
+        texture_target != GL_TEXTURE_RECTANGLE &&
+        !is_cube_face(texture_target)) {
+        cl_int err = CL_INVALID_VALUE;
+        if (!is_valid_context(context) || gl_interop_of(context) == nullptr) {
+            err = CL_INVALID_CONTEXT;
+        }
+        cvk_interop_set_error(errcode_ret, err);
+        return nullptr;
+    }
+    return create_from_texture(context, flags, texture_target, miplevel,
+                               texture, errcode_ret);
+}
+
+cl_mem CLVK_API_CALL clCreateFromGLTexture3D(
+    cl_context context, cl_mem_flags flags, cl_GLenum texture_target,
+    cl_GLint miplevel, cl_GLuint texture, cl_int* errcode_ret) {
+    if (texture_target != GL_TEXTURE_3D) {
+        cl_int err = CL_INVALID_VALUE;
+        if (!is_valid_context(context) || gl_interop_of(context) == nullptr) {
+            err = CL_INVALID_CONTEXT;
+        }
+        cvk_interop_set_error(errcode_ret, err);
+        return nullptr;
+    }
+    return create_from_texture(context, flags, texture_target, miplevel,
+                               texture, errcode_ret);
+}
+
+cl_mem CLVK_API_CALL clCreateFromGLRenderbuffer(cl_context context,
+                                                cl_mem_flags flags,
+                                                cl_GLuint renderbuffer,
+                                                cl_int* errcode_ret) {
+    cvk_gl_interop* device = nullptr;
+    cl_int err = check_create(context, flags, &device);
+    gl_shape shape;
+    if (err == CL_SUCCESS) {
+        err = device->run([&] {
+            return describe_renderbuffer(device->api(), renderbuffer, &shape);
+        });
+    }
+    if (err != CL_SUCCESS) {
+        cvk_interop_set_error(errcode_ret, err);
+        return nullptr;
+    }
+    return create_image(context, flags, device, renderbuffer, GL_RENDERBUFFER,
+                        0, shape, errcode_ret);
+}
+
+cl_int CLVK_API_CALL clGetGLObjectInfo(cl_mem memobj,
+                                       cl_gl_object_type* gl_object_type,
+                                       cl_GLuint* gl_object_name) {
+    if (!is_valid_mem_object(memobj)) {
+        return CL_INVALID_MEM_OBJECT;
+    }
+    auto object = gl_object_of(memobj);
+    if (object == nullptr) {
+        return CL_INVALID_GL_OBJECT;
+    }
+    if (gl_object_type != nullptr) {
+        *gl_object_type = object->type();
+    }
+    if (gl_object_name != nullptr) {
+        *gl_object_name = object->name();
+    }
+    return CL_SUCCESS;
+}
+
+cl_int CLVK_API_CALL clGetGLTextureInfo(cl_mem memobj,
+                                        cl_gl_texture_info param_name,
+                                        size_t param_value_size,
+                                        void* param_value,
+                                        size_t* param_value_size_ret) {
+    if (!is_valid_mem_object(memobj)) {
+        return CL_INVALID_MEM_OBJECT;
+    }
+    auto object = gl_object_of(memobj);
+    if (object == nullptr || object->type() == CL_GL_OBJECT_BUFFER ||
+        object->type() == CL_GL_OBJECT_RENDERBUFFER) {
+        return CL_INVALID_GL_OBJECT;
+    }
+    cl_GLenum target = object->target();
+    cl_GLint level = object->level();
+    const void* value;
+    size_t size;
+    switch (param_name) {
+    case CL_GL_TEXTURE_TARGET:
+        value = &target;
+        size = sizeof(target);
+        break;
+    case CL_GL_MIPMAP_LEVEL:
+        value = &level;
+        size = sizeof(level);
+        break;
+    default:
+        return CL_INVALID_VALUE;
+    }
+    if (param_value != nullptr) {
+        if (param_value_size < size) {
+            return CL_INVALID_VALUE;
+        }
+        memcpy(param_value, value, size);
+    }
+    if (param_value_size_ret != nullptr) {
+        *param_value_size_ret = size;
+    }
+    return CL_SUCCESS;
+}
+
+cl_int CLVK_API_CALL clEnqueueAcquireGLObjects(cl_command_queue command_queue,
+                                               cl_uint num_objects,
+                                               const cl_mem* mem_objects,
+                                               cl_uint num_events_in_wait_list,
+                                               const cl_event* event_wait_list,
+                                               cl_event* event) {
+    return cvk_interop_acquire(cvk_interop_api::gl, command_queue, num_objects,
+                               mem_objects, num_events_in_wait_list,
+                               event_wait_list, event);
+}
+
+cl_int CLVK_API_CALL clEnqueueReleaseGLObjects(cl_command_queue command_queue,
+                                               cl_uint num_objects,
+                                               const cl_mem* mem_objects,
+                                               cl_uint num_events_in_wait_list,
+                                               const cl_event* event_wait_list,
+                                               cl_event* event) {
+    return cvk_interop_release(cvk_interop_api::gl, command_queue, num_objects,
+                               mem_objects, num_events_in_wait_list,
+                               event_wait_list, event);
+}
