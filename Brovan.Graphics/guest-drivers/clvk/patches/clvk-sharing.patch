+namespace {
+
+// Holds a release command until its publish is done. The executor runs and
+// deletes the commands of a queue in order, so once the release command has
+// started, none of the earlier moves still holds a memory object.
+struct cvk_interop_gate {
+    void start() {
+        std::lock_guard<std::mutex> lock(m_lock);
+        m_started = true;
+        m_cv.notify_all();
+    }
+
+    void wait_started() {
+        std::unique_lock<std::mutex> lock(m_lock);
+        m_cv.wait(lock, [this] { return m_started; });
+    }
+
+    void finish(cl_int status) {
+        std::lock_guard<std::mutex> lock(m_lock);
+        m_status = status;
+        m_finished = true;
+        m_cv.notify_all();
+    }
+
+    cl_int wait_finished() {
+        std::unique_lock<std::mutex> lock(m_lock);
+        m_cv.wait(lock, [this] { return m_finished; });
+        return m_status;
+    }
+
+private:
+    std::mutex m_lock;
+    std::condition_variable m_cv;
+    bool m_started = false;
+    bool m_finished = false;
+    cl_int m_status = CL_COMPLETE;
+};
+
+struct cvk_command_interop final : public cvk_command {
+    cvk_command_interop(cvk_command_queue* queue, cl_command_type type,
+                        std::shared_ptr<cvk_interop_gate> gate)
+        : cvk_command(type, queue), m_gate(std::move(gate)) {}
+
+private:
+    cl_int do_action() override final {
+        if (!m_gate) {
+            return CL_COMPLETE;
+        }
+        m_gate->start();
+        return m_gate->wait_finished();
+    }
+
+    std::shared_ptr<cvk_interop_gate> m_gate;
+};
+
+struct cvk_interop_request {
+    cvk_command_queue* queue = nullptr;
+    cvk_interop_device* device = nullptr;
+    std::vector<cvk_mem*> mems;
+    std::vector<cvk_interop_object*> objects;
+};
+
+cl_int collect(cvk_interop_api api, cl_command_queue queue, cl_uint num_objects,
+               const cl_mem* mem_objects, cl_uint num_events_in_wait_list,
+               const cl_event* event_wait_list, cvk_interop_request* request) {
+    if (!is_valid_command_queue(queue)) {
+        return CL_INVALID_COMMAND_QUEUE;
+    }
+    if ((num_objects == 0) != (mem_objects == nullptr)) {
+        return CL_INVALID_VALUE;
+    }
+    auto command_queue = icd_downcast(queue);
+    auto device = command_queue->context()->interop();
+    if (device == nullptr || device->api() != api) {
+        return CL_INVALID_CONTEXT;
+    }
+    for (cl_uint i = 0; i < num_objects; i++) {
+        if (!is_valid_mem_object(mem_objects[i])) {
+            return CL_INVALID_MEM_OBJECT;
+        }
+        auto mem = icd_downcast(mem_objects[i]);
+        auto object = mem->interop();
+        if (object == nullptr || object->device() != device) {
+            return device->foreign_object_error();
+        }
+        request->mems.push_back(mem);
+        request->objects.push_back(object);
+    }
+    if (!is_valid_event_wait_list(num_events_in_wait_list, event_wait_list)) {
+        return CL_INVALID_EVENT_WAIT_LIST;
+    }
+    request->queue = command_queue;
+    request->device = device;
+    return CL_SUCCESS;
+}
+
+cl_int enqueue_move(cvk_command_queue* queue, cvk_mem* mem,
+                    cvk_interop_object* object, bool into_mem,
+                    cl_uint num_events, const cl_event* events,
+                    cl_event* done) {
+    if (mem->is_buffer_type()) {
+        auto cmd = new cvk_command_buffer_host_copy(
+            queue, into_mem ? CL_COMMAND_WRITE_BUFFER : CL_COMMAND_READ_BUFFER,
+            static_cast<cvk_buffer*>(mem), object->host_data(), 0,
+            object->host_size());
+        return queue->enqueue_command_with_deps(cmd, false, num_events, events,
+                                                done);
+    }
+
+    auto image = static_cast<cvk_image*>(mem);
+    const size_t origin[3] = {0, 0, 0};
+    size_t region[3] = {image->width(), std::max<size_t>(image->height(), 1),
+                        1};
+    switch (image->type()) {
+    case CL_MEM_OBJECT_IMAGE3D:
+        region[2] = image->depth();
+        break;
+    case CL_MEM_OBJECT_IMAGE2D_ARRAY:
+        region[2] = image->array_size();
+        break;
+    case CL_MEM_OBJECT_IMAGE1D_ARRAY:
+        region[1] = image->array_size();
+        break;
+    default:
+        break;
+    }
+    return cvk_enqueue_image_copy(
+        queue, into_mem ? CL_COMMAND_WRITE_IMAGE : CL_COMMAND_READ_IMAGE, mem,
+        false, origin, region, object->row_pitch(), object->slice_pitch(),
+        object->host_data(), num_events, events, done);
+}
+
+void release_events(std::vector<cl_event>& events) {
+    for (auto event : events) {
+        icd_downcast(event)->release();
+    }
+    events.clear();
+}
+
+std::vector<cvk_interop_object*>
+changed_objects(const std::vector<cvk_interop_object*>& objects,
+                const std::vector<bool>& changes) {
+    std::vector<cvk_interop_object*> changed;
+    for (size_t i = 0; i < objects.size(); i++) {
+        if (changes[i]) {
+            changed.push_back(objects[i]);
+        }
+    }
+    return changed;
+}
+
+bool has_incomplete_user_event(cl_uint num_events, const cl_event* events) {
+    for (cl_uint i = 0; i < num_events; i++) {
+        auto event = icd_downcast(events[i]);
+        if (event->is_user_event() && !event->completed()) {
+            return true;
+        }
+    }
+    return false;
+}
+
+} // namespace
+
+cl_int cvk_interop_acquire(cvk_interop_api api, cl_command_queue queue,
+                           cl_uint num_objects, const cl_mem* mem_objects,
+                           cl_uint num_events_in_wait_list,
+                           const cl_event* event_wait_list, cl_event* event) {
+    cvk_interop_request request;
+    cl_int err = collect(api, queue, num_objects, mem_objects,
+                         num_events_in_wait_list, event_wait_list, &request);
+    if (err != CL_SUCCESS || num_objects == 0) {
+        return err;
+    }
+
+    std::vector<bool> changes;
+    err = request.device->mark(request.objects, true, &changes);
+    if (err != CL_SUCCESS) {
+        return err;
+    }
+
+    auto changed = changed_objects(request.objects, changes);
+    if (!changed.empty()) {
+        err = request.device->capture(changed);
+    }
+
+    std::vector<cl_event> moves;
+    for (size_t i = 0; i < request.objects.size() && err == CL_SUCCESS; i++) {
+        if (!changes[i]) {
+            continue;
+        }
+        cl_event done;
+        err =
+            enqueue_move(request.queue, request.mems[i], request.objects[i],
+                         true, num_events_in_wait_list, event_wait_list, &done);
+        if (err == CL_SUCCESS) {
+            moves.push_back(done);
+        }
+    }
+
+    if (err == CL_SUCCESS) {
+        auto cmd = new cvk_command_interop(
+            request.queue, request.device->acquire_command(), nullptr);
+        if (moves.empty()) {
+            err = request.queue->enqueue_command_with_deps(
+                cmd, false, num_events_in_wait_list, event_wait_list, event);
+        } else {
+            err = request.queue->enqueue_command_with_deps(
+                cmd, false, static_cast<cl_uint>(moves.size()), moves.data(),
+                event);
+        }
+    }
+
+    release_events(moves);
+    if (err != CL_SUCCESS) {
+        request.device->unmark(request.objects, changes, false);
+    }
+    return err;
+}
+
+cl_int cvk_interop_release(cvk_interop_api api, cl_command_queue queue,
+                           cl_uint num_objects, const cl_mem* mem_objects,
+                           cl_uint num_events_in_wait_list,
+                           const cl_event* event_wait_list, cl_event* event) {
+    cvk_interop_request request;
+    cl_int err = collect(api, queue, num_objects, mem_objects,
+                         num_events_in_wait_list, event_wait_list, &request);
+    if (err != CL_SUCCESS || num_objects == 0) {
+        return err;
+    }
+
+    std::vector<bool> changes;
+    err = request.device->mark(request.objects, false, &changes);
+    if (err != CL_SUCCESS) {
+        return err;
+    }
+    if (std::find(changes.begin(), changes.end(), true) == changes.end()) {
+        auto cmd = new cvk_command_interop(
+            request.queue, request.device->release_command(), nullptr);
+        return request.queue->enqueue_command_with_deps(
+            cmd, false, num_events_in_wait_list, event_wait_list, event);
+    }
+    if (has_incomplete_user_event(num_events_in_wait_list, event_wait_list)) {
+        request.device->report_user_event_wait();
+    }
+
+    // The objects come back only after the wait list and every command
+    // already in the queue.
+    cl_event barrier = nullptr;
+    err = cvk_enqueue_barrier_with_wait_list(
+        request.queue, num_events_in_wait_list, event_wait_list, &barrier);
+
+    std::vector<cl_event> moves;
+    for (size_t i = 0; i < request.objects.size() && err == CL_SUCCESS; i++) {
+        if (!changes[i]) {
+            continue;
+        }
+        cl_event done;
+        err = enqueue_move(request.queue, request.mems[i], request.objects[i],
+                           false, 1, &barrier, &done);
+        if (err == CL_SUCCESS) {
+            moves.push_back(done);
+        }
+    }
+
+    auto gate = std::make_shared<cvk_interop_gate>();
+    if (err == CL_SUCCESS) {
+        auto cmd = new cvk_command_interop(
+            request.queue, request.device->release_command(), gate);
+        err = request.queue->enqueue_command_with_deps(
+            cmd, false, static_cast<cl_uint>(moves.size()), moves.data(),
+            event);
+    }
+    if (err == CL_SUCCESS) {
+        err = request.queue->flush();
+    }
+
+    cl_int status = err == CL_SUCCESS ? CL_COMPLETE : err;
+    for (auto done : moves) {
+        if (icd_downcast(done)->wait() != CL_COMPLETE) {
+            status = CL_OUT_OF_RESOURCES;
+        }
+    }
+    // A failed move makes the executor skip the release command's action.
+    if (status == CL_COMPLETE) {
+        gate->wait_started();
+        if (request.device->publish(
+                changed_objects(request.objects, changes)) != CL_SUCCESS) {
+            status = CL_OUT_OF_RESOURCES;
+        }
+    }
+    gate->finish(status);
+
+    release_events(moves);
+    if (barrier != nullptr) {
+        icd_downcast(barrier)->release();
+    }
+    if (err != CL_SUCCESS) {
+        request.device->unmark(request.objects, changes, true);
+    }
+    return err;
+}
+
+namespace {
+
+bool property_api(cl_context_properties property, cvk_interop_api* api) {
+#ifdef _WIN32
+    switch (property) {
+    case CL_CONTEXT_D3D10_DEVICE_KHR:
+        *api = cvk_interop_api::d3d10;
+        return true;
+    case CL_GL_CONTEXT_KHR:
+    case CL_WGL_HDC_KHR:
+    case CL_EGL_DISPLAY_KHR:
+    case CL_GLX_DISPLAY_KHR:
+    case CL_CGL_SHAREGROUP_KHR:
+        *api = cvk_interop_api::gl;
+        return true;
+    default:
+        return false;
+    }
+#else
+    UNUSED(property);
+    UNUSED(api);
+    return false;
+#endif
+}
+
+} // namespace
+
+bool cvk_is_interop_context_property(cl_context_properties property) {
+    cvk_interop_api api;
+    return property_api(property, &api);
+}
+
+cl_int cvk_interop_named_api(const cl_context_properties* properties,
+                             bool* named, cvk_interop_api* api) {
+    *named = false;
+    for (auto property = properties; property != nullptr && property[0] != 0;
+         property += 2) {
+        cvk_interop_api found;
+        if (property[1] == 0 || !property_api(property[0], &found)) {
+            continue;
+        }
+        if (*named && found != *api) {
+            return CL_INVALID_OPERATION;
+        }
+        *named = true;
+        *api = found;
+    }
+    return CL_SUCCESS;
+}
+
+cl_int cvk_create_interop_device(cvk_device* device,
+                                 const cl_context_properties* properties,
+                                 cvk_interop_device** created) {
+    *created = nullptr;
+    bool named;
+    cvk_interop_api api;
+    cl_int err = cvk_interop_named_api(properties, &named, &api);
+    if (err != CL_SUCCESS || !named) {
+        return err;
+    }
+#ifdef _WIN32
+    switch (api) {
+    case cvk_interop_api::d3d10:
+        return cvk_create_d3d10_interop(device, properties, created);
+    case cvk_interop_api::gl:
+        return cvk_create_gl_interop(device, properties, created);
+    }
+#endif
+    UNUSED(device);
+    return CL_SUCCESS;
+}
