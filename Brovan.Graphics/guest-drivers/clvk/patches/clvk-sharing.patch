+
+// One subresource of a Direct3D 10 resource, moved through a staging copy of
+// it.
+struct cvk_d3d10_object final : public cvk_interop_object {
+    cvk_d3d10_object(cvk_d3d10_interop* device, ID3D10Resource* resource,
+                     UINT subresource)
+        : cvk_interop_object(device, resource, subresource),
+          m_d3d(device->d3d()), m_resource(resource) {
+        m_resource->AddRef();
+    }
+
+    ~cvk_d3d10_object() override {
+        if (m_staging != nullptr) {
+            m_staging->Release();
+        }
+        m_resource->Release();
+    }
+
+    void set_staging(ID3D10Resource* staging, D3D10_RESOURCE_DIMENSION kind) {
+        m_staging = staging;
+        m_kind = kind;
+    }
+
+    cl_int capture() override {
+        m_d3d->CopySubresourceRegion(m_staging, 0, 0, 0, 0, m_resource,
+                                     subresource(), nullptr);
+        uint8_t* data;
+        size_t row_pitch;
+        size_t depth_pitch;
+        if (!map(D3D10_MAP_READ, &data, &row_pitch, &depth_pitch)) {
+            return CL_OUT_OF_RESOURCES;
+        }
+        pack(data, row_pitch, depth_pitch);
+        unmap();
+        return CL_SUCCESS;
+    }
+
+    cl_int publish() override {
+        uint8_t* data;
+        size_t row_pitch;
+        size_t depth_pitch;
+        if (!map(D3D10_MAP_WRITE, &data, &row_pitch, &depth_pitch)) {
+            return CL_OUT_OF_RESOURCES;
+        }
+        unpack(data, row_pitch, depth_pitch);
+        unmap();
+        m_d3d->CopySubresourceRegion(m_resource, subresource(), 0, 0, 0,
+                                     m_staging, 0, nullptr);
+        return CL_SUCCESS;
+    }
+
+private:
+    bool map(D3D10_MAP type, uint8_t** data, size_t* row_pitch,
+             size_t* depth_pitch) {
+        HRESULT hr;
+        void* mapped = nullptr;
+        *row_pitch = 0;
+        *depth_pitch = 0;
+        if (m_kind == D3D10_RESOURCE_DIMENSION_BUFFER) {
+            hr = static_cast<ID3D10Buffer*>(m_staging)->Map(type, 0, &mapped);
+        } else if (m_kind == D3D10_RESOURCE_DIMENSION_TEXTURE2D) {
+            D3D10_MAPPED_TEXTURE2D texture;
+            hr = static_cast<ID3D10Texture2D*>(m_staging)->Map(0, type, 0,
+                                                               &texture);
+            mapped = texture.pData;
+            *row_pitch = texture.RowPitch;
+        } else {
+            D3D10_MAPPED_TEXTURE3D texture;
+            hr = static_cast<ID3D10Texture3D*>(m_staging)->Map(0, type, 0,
+                                                               &texture);
+            mapped = texture.pData;
+            *row_pitch = texture.RowPitch;
+            *depth_pitch = texture.DepthPitch;
+        }
+        *data = static_cast<uint8_t*>(mapped);
+        return SUCCEEDED(hr) && mapped != nullptr;
+    }
+
+    void unmap() {
+        if (m_kind == D3D10_RESOURCE_DIMENSION_BUFFER) {
+            static_cast<ID3D10Buffer*>(m_staging)->Unmap();
+        } else if (m_kind == D3D10_RESOURCE_DIMENSION_TEXTURE2D) {
+            static_cast<ID3D10Texture2D*>(m_staging)->Unmap(0);
+        } else {
+            static_cast<ID3D10Texture3D*>(m_staging)->Unmap(0);
+        }
+    }
+
+    ID3D10Device* m_d3d;
+    ID3D10Resource* m_resource;
+    ID3D10Resource* m_staging = nullptr;
+    D3D10_RESOURCE_DIMENSION m_kind = D3D10_RESOURCE_DIMENSION_UNKNOWN;
+};
+
+// The checks every create shares, in the order of the extension's error
+// list. On success the object holds the resource and its wrapped entry.
+cl_int start_object(cl_context ctx, cl_mem_flags flags,
+                    ID3D10Resource* resource, D3D10_RESOURCE_DIMENSION kind,
+                    bool subresource_exists, UINT subresource, UINT usage,
+                    UINT sample_count,
+                    std::unique_ptr<cvk_d3d10_object>* object) {
+    cl_int err = cvk_interop_check_create(ctx, flags);
+    if (err != CL_SUCCESS) {
+        return err;
+    }
+    if (resource != nullptr && !subresource_exists) {
+        return CL_INVALID_VALUE;
+    }
+    if (resource == nullptr) {
+        return CL_INVALID_D3D10_RESOURCE_KHR;
+    }
+    D3D10_RESOURCE_DIMENSION actual;
+    resource->GetType(&actual);
+    auto interop = icd_downcast(ctx)->interop();
+    if (actual != kind || interop == nullptr ||
+        interop->api() != cvk_interop_api::d3d10 ||
+        !cvk_dxgi_can_share(usage, sample_count)) {
+        return CL_INVALID_D3D10_RESOURCE_KHR;
+    }
+    auto device = static_cast<cvk_d3d10_interop*>(interop);
+    ID3D10Device* owner = nullptr;
+    resource->GetDevice(&owner);
+    if (owner != nullptr) {
+        owner->Release();
+    }
+    if (owner != device->d3d() || !device->add_wrapped(resource, subresource)) {
+        return CL_INVALID_D3D10_RESOURCE_KHR;
+    }
+    object->reset(new cvk_d3d10_object(device, resource, subresource));
+    return CL_SUCCESS;
+}
+
+ID3D10Device* d3d_of(const std::unique_ptr<cvk_d3d10_object>& object) {
+    return static_cast<cvk_d3d10_interop*>(object->device())->d3d();
+}
+
+} // namespace
+
+cl_int cvk_create_d3d10_interop(cvk_device* device,
+                                const cl_context_properties* properties,
+                                cvk_interop_device** created) {
+    ID3D10Device* d3d_device = nullptr;
+    for (auto property = properties; property[0] != 0; property += 2) {
+        if (property[0] == CL_CONTEXT_D3D10_DEVICE_KHR) {
+            d3d_device = reinterpret_cast<ID3D10Device*>(property[1]);
+        }
+    }
+    LUID luid;
+    if (!device->luid_valid() || !cvk_dxgi_device_luid(d3d_device, &luid) ||
+        memcmp(device->luid(), &luid, sizeof(luid)) != 0) {
+        return CL_INVALID_D3D10_DEVICE_KHR;
+    }
+    *created = new cvk_d3d10_interop(d3d_device);
+    return CL_SUCCESS;
+}
+
+cl_int CLVK_API_CALL clGetDeviceIDsFromD3D10KHR(
+    cl_platform_id platform, cl_d3d10_device_source_khr d3d_device_source,
+    void* d3d_object, cl_d3d10_device_set_khr d3d_device_set,
+    cl_uint num_entries, cl_device_id* devices, cl_uint* num_devices) {
+    if (!is_valid_platform(platform)) {
+        return CL_INVALID_PLATFORM;
+    }
+    if ((d3d_device_source != CL_D3D10_DEVICE_KHR &&
+         d3d_device_source != CL_D3D10_DXGI_ADAPTER_KHR) ||
+        (d3d_device_set != CL_PREFERRED_DEVICES_FOR_D3D10_KHR &&
+         d3d_device_set != CL_ALL_DEVICES_FOR_D3D10_KHR) ||
+        d3d_object == nullptr) {
+        return CL_INVALID_VALUE;
+    }
+
+    LUID luid;
+    bool known = d3d_device_source == CL_D3D10_DEVICE_KHR
+                     ? cvk_dxgi_device_luid(
+                           static_cast<ID3D10Device*>(d3d_object), &luid)
+                     : cvk_dxgi_adapter_luid(
+                           static_cast<IDXGIAdapter*>(d3d_object), &luid);
+    if (!known) {
+        return CL_INVALID_VALUE;
+    }
+
+    auto found = icd_downcast(platform)->devices_with_luid(&luid);
+    if (found.empty()) {
+        return CL_DEVICE_NOT_FOUND;
+    }
+    if (devices != nullptr) {
+        for (cl_uint i = 0; i < num_entries && i < found.size(); i++) {
+            devices[i] = found[i];
+        }
+    }
+    if (num_devices != nullptr) {
+        *num_devices = static_cast<cl_uint>(found.size());
+    }
+    return CL_SUCCESS;
+}
+
+cl_mem CLVK_API_CALL clCreateFromD3D10BufferKHR(cl_context context,
+                                                cl_mem_flags flags,
+                                                ID3D10Buffer* resource,
+                                                cl_int* errcode_ret) {
+    D3D10_BUFFER_DESC desc = {};
+    if (resource != nullptr) {
+        resource->GetDesc(&desc);
+    }
+    std::unique_ptr<cvk_d3d10_object> object;
+    cl_int err =
+        start_object(context, flags, resource, D3D10_RESOURCE_DIMENSION_BUFFER,
+                     true, 0, desc.Usage, 1, &object);
+    if (err != CL_SUCCESS) {
+        cvk_interop_set_error(errcode_ret, err);
+        return nullptr;
+    }
+
+    D3D10_BUFFER_DESC staging_desc = {
+        desc.ByteWidth, D3D10_USAGE_STAGING, 0,
+        D3D10_CPU_ACCESS_READ | D3D10_CPU_ACCESS_WRITE, 0};
+    ID3D10Buffer* staging = nullptr;
+    if (FAILED(
+            d3d_of(object)->CreateBuffer(&staging_desc, nullptr, &staging))) {
+        cvk_interop_set_error(errcode_ret, CL_OUT_OF_RESOURCES);
+        return nullptr;
+    }
+    object->set_staging(staging, D3D10_RESOURCE_DIMENSION_BUFFER);
+    err = object->set_layout(desc.ByteWidth, 1, 1,
+                             cvk_interop_max_bytes(context));
+    if (err != CL_SUCCESS) {
+        cvk_interop_set_error(errcode_ret, err);
+        return nullptr;
+    }
+
+    return cvk_interop_create_buffer(context, flags, desc.ByteWidth,
+                                     std::move(object), errcode_ret);
+}
+
+cl_mem CLVK_API_CALL clCreateFromD3D10Texture2DKHR(cl_context context,
+                                                   cl_mem_flags flags,
+                                                   ID3D10Texture2D* resource,
+                                                   UINT subresource,
+                                                   cl_int* errcode_ret) {
+    D3D10_TEXTURE2D_DESC desc = {};
+    if (resource != nullptr) {
+        resource->GetDesc(&desc);
+    }
+    UINT width = 0, height = 0, depth = 0;
+    bool exists = cvk_dxgi_subresource_extent(
+        desc.Width, desc.Height, 1, desc.MipLevels, desc.ArraySize, subresource,
+        &width, &height, &depth);
+    std::unique_ptr<cvk_d3d10_object> object;
+    cl_int err = start_object(
+        context, flags, resource, D3D10_RESOURCE_DIMENSION_TEXTURE2D, exists,
+        subresource, desc.Usage, desc.SampleDesc.Count, &object);
+    cl_image_format format;
+    size_t element_size = 0;
+    if (err == CL_SUCCESS &&
+        !cvk_dxgi_image_format(desc.Format, &format, &element_size)) {
+        err = CL_INVALID_IMAGE_FORMAT_DESCRIPTOR;
+    }
+    if (err != CL_SUCCESS) {
+        cvk_interop_set_error(errcode_ret, err);
+        return nullptr;
+    }
+
+    D3D10_TEXTURE2D_DESC staging_desc = {width,
+                                         height,
+                                         1,
+                                         1,
+                                         desc.Format,
+                                         {1, 0},
+                                         D3D10_USAGE_STAGING,
+                                         0,
+                                         D3D10_CPU_ACCESS_READ |
+                                             D3D10_CPU_ACCESS_WRITE,
+                                         0};
+    ID3D10Texture2D* staging = nullptr;
+    if (FAILED(d3d_of(object)->CreateTexture2D(&staging_desc, nullptr,
+                                               &staging))) {
+        cvk_interop_set_error(errcode_ret, CL_OUT_OF_RESOURCES);
+        return nullptr;
+    }
+    object->set_staging(staging, D3D10_RESOURCE_DIMENSION_TEXTURE2D);
+    err = object->set_layout(width * element_size, height, 1,
+                             cvk_interop_max_bytes(context));
+    if (err != CL_SUCCESS) {
+        cvk_interop_set_error(errcode_ret, err);
+        return nullptr;
+    }
+
+    cl_image_desc image_desc = {};
+    image_desc.image_type = CL_MEM_OBJECT_IMAGE2D;
+    image_desc.image_width = width;
+    image_desc.image_height = height;
+    return cvk_interop_create_image(context, flags, format, image_desc,
+                                    std::move(object), errcode_ret);
+}
+
+cl_mem CLVK_API_CALL clCreateFromD3D10Texture3DKHR(cl_context context,
+                                                   cl_mem_flags flags,
+                                                   ID3D10Texture3D* resource,
+                                                   UINT subresource,
+                                                   cl_int* errcode_ret) {
+    D3D10_TEXTURE3D_DESC desc = {};
+    if (resource != nullptr) {
+        resource->GetDesc(&desc);
+    }
+    UINT width = 0, height = 0, depth = 0;
+    bool exists = cvk_dxgi_subresource_extent(
+        desc.Width, desc.Height, desc.Depth, desc.MipLevels, 1, subresource,
+        &width, &height, &depth);
+    std::unique_ptr<cvk_d3d10_object> object;
+    cl_int err = start_object(context, flags, resource,
+                              D3D10_RESOURCE_DIMENSION_TEXTURE3D, exists,
+                              subresource, desc.Usage, 1, &object);
+    cl_image_format format;
+    size_t element_size = 0;
+    if (err == CL_SUCCESS &&
+        !cvk_dxgi_image_format(desc.Format, &format, &element_size)) {
+        err = CL_INVALID_IMAGE_FORMAT_DESCRIPTOR;
+    }
+    if (err != CL_SUCCESS) {
+        cvk_interop_set_error(errcode_ret, err);
+        return nullptr;
+    }
+
+    D3D10_TEXTURE3D_DESC staging_desc = {width,
+                                         height,
+                                         depth,
+                                         1,
+                                         desc.Format,
+                                         D3D10_USAGE_STAGING,
+                                         0,
+                                         D3D10_CPU_ACCESS_READ |
+                                             D3D10_CPU_ACCESS_WRITE,
+                                         0};
+    ID3D10Texture3D* staging = nullptr;
+    if (FAILED(d3d_of(object)->CreateTexture3D(&staging_desc, nullptr,
+                                               &staging))) {
+        cvk_interop_set_error(errcode_ret, CL_OUT_OF_RESOURCES);
+        return nullptr;
+    }
+    object->set_staging(staging, D3D10_RESOURCE_DIMENSION_TEXTURE3D);
+    err = object->set_layout(width * element_size, height, depth,
+                             cvk_interop_max_bytes(context));
+    if (err != CL_SUCCESS) {
+        cvk_interop_set_error(errcode_ret, err);
+        return nullptr;
+    }
+
+    cl_image_desc image_desc = {};
+    image_desc.image_type = CL_MEM_OBJECT_IMAGE3D;
+    image_desc.image_width = width;
+    image_desc.image_height = height;
+    image_desc.image_depth = depth;
+    return cvk_interop_create_image(context, flags, format, image_desc,
+                                    std::move(object), errcode_ret);
+}
+
+cl_int CLVK_API_CALL clEnqueueAcquireD3D10ObjectsKHR(
+    cl_command_queue command_queue, cl_uint num_objects,
