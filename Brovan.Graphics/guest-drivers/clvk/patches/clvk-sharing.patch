+    BOOL(WINAPI* destroy_pbuffer)(HANDLE);
+    HGLRC(WINAPI* create_context_attribs)(HDC, HGLRC, const int*);
+    int (*query_device_info)(HDC, HGLRC, mesa_glinterop_device_info*);
+    void(APIENTRY* get_integer)(GLenum, GLint*);
+    const unsigned char*(APIENTRY* get_string_i)(GLenum, GLuint);
+    void(APIENTRY* pixel_store)(GLenum, GLint);
+    void(APIENTRY* finish)();
