+cvk_interop_object::~cvk_interop_object() {
+    m_device->remove_wrapped(m_external, m_subresource);
+}
+
+cl_int cvk_interop_object::set_layout(size_t row_bytes, size_t rows,
+                                      size_t slices, uint64_t max_bytes) {
+    if (row_bytes == 0 || rows == 0 || slices == 0 ||
+        row_bytes > max_bytes / rows ||
+        uint64_t(row_bytes) * rows > max_bytes / slices) {
+        return CL_OUT_OF_RESOURCES;
+    }
+    uint64_t total = uint64_t(row_bytes) * rows * slices;
+    if (total > SIZE_MAX) {
+        return CL_OUT_OF_RESOURCES;
+    }
+    try {
+        m_host.resize(static_cast<size_t>(total));
+    } catch (const std::bad_alloc&) {
+        return CL_OUT_OF_HOST_MEMORY;
+    }
+    m_row_bytes = row_bytes;
+    m_rows = rows;
+    m_slices = slices;
+    return CL_SUCCESS;
+}
+
+void cvk_interop_object::pack(const uint8_t* mapped, size_t row_pitch,
+                              size_t depth_pitch) {
+    for (size_t slice = 0; slice < m_slices; slice++) {
+        for (size_t row = 0; row < m_rows; row++) {
+            memcpy(m_host.data() + (slice * m_rows + row) * m_row_bytes,
+                   mapped + slice * depth_pitch + row * row_pitch, m_row_bytes);
+        }
+    }
+}
+
+void cvk_interop_object::unpack(uint8_t* mapped, size_t row_pitch,
+                                size_t depth_pitch) const {
+    for (size_t slice = 0; slice < m_slices; slice++) {
+        for (size_t row = 0; row < m_rows; row++) {
+            memcpy(mapped + slice * depth_pitch + row * row_pitch,
+                   m_host.data() + (slice * m_rows + row) * m_row_bytes,
+                   m_row_bytes);
+        }
+    }
+}
+
+cl_int cvk_interop_check_create(cl_context context, cl_mem_flags flags) {
+    if (!is_valid_context(context)) {
+        return CL_INVALID_CONTEXT;
+    }
+    const cl_mem_flags access =
+        CL_MEM_READ_WRITE | CL_MEM_WRITE_ONLY | CL_MEM_READ_ONLY;
+    int set = ((flags & CL_MEM_READ_WRITE) != 0) +
+              ((flags & CL_MEM_WRITE_ONLY) != 0) +
+              ((flags & CL_MEM_READ_ONLY) != 0);
+    if ((flags & ~access) != 0 || set > 1) {
+        return CL_INVALID_VALUE;
+    }
+    return CL_SUCCESS;
+}
+
+void cvk_interop_set_error(cl_int* errcode_ret, cl_int err) {
+    if (errcode_ret != nullptr) {
+        *errcode_ret = err;
+    }
+}
+
+uint64_t cvk_interop_max_bytes(cl_context context) {
+    return icd_downcast(context)->device()->max_mem_alloc_size();
+}
+
+cl_mem cvk_interop_create_buffer(cl_context context, cl_mem_flags flags,
+                                 size_t size,
+                                 std::unique_ptr<cvk_interop_object> object,
+                                 cl_int* errcode_ret) {
+    cl_int err;
+    auto buffer = cvk_buffer::create(icd_downcast(context), flags, size,
+                                     nullptr, {}, &err);
+    if (buffer == nullptr) {
+        cvk_interop_set_error(errcode_ret, err);
+        return nullptr;
+    }
+    buffer->set_interop(std::move(object));
+    cvk_interop_set_error(errcode_ret, CL_SUCCESS);
+    return buffer.release();
+}
+
+cl_mem cvk_interop_create_image(cl_context context, cl_mem_flags flags,
+                                const cl_image_format& format,
+                                const cl_image_desc& desc,
+                                std::unique_ptr<cvk_interop_object> object,
+                                cl_int* errcode_ret) {
+    cl_int err;
+    cl_mem image =
+        cvk_create_image(context, flags, &format, &desc, nullptr, {}, &err);
+    if (image == nullptr) {
+        cvk_interop_set_error(errcode_ret,
+                              err == CL_IMAGE_FORMAT_NOT_SUPPORTED
+                                  ? CL_INVALID_IMAGE_FORMAT_DESCRIPTOR
+                                  : err);
+        return nullptr;
+    }
+    icd_downcast(image)->set_interop(std::move(object));
+    cvk_interop_set_error(errcode_ret, CL_SUCCESS);
+    return image;
+}
+
+bool cvk_interop_device::add_wrapped(void* external, uint32_t subresource) {
+    std::lock_guard<std::mutex> lock(m_lock);
+    return m_wrapped.emplace(external, subresource).second;
+}
+
+cl_int
+cvk_interop_device::capture(const std::vector<cvk_interop_object*>& objects) {
+    for (auto object : objects) {
+        cl_int err = object->capture();
+        if (err != CL_SUCCESS) {
+            return err;
+        }
+    }
+    return CL_SUCCESS;
+}
+
+cl_int
+cvk_interop_device::publish(const std::vector<cvk_interop_object*>& objects) {
+    cl_int status = CL_SUCCESS;
+    for (auto object : objects) {
+        if (object->publish() != CL_SUCCESS) {
+            status = CL_OUT_OF_RESOURCES;
+        }
+    }
+    return status;
+}
+
+void cvk_interop_device::remove_wrapped(void* external, uint32_t subresource) {
+    std::lock_guard<std::mutex> lock(m_lock);
+    m_wrapped.erase({external, subresource});
+}
+
+cl_int cvk_interop_device::mark(const std::vector<cvk_interop_object*>& objects,
+                                bool acquire, std::vector<bool>* moves) {
+    std::lock_guard<std::mutex> lock(m_lock);
+    cl_int error = acquire ? already_acquired_error() : not_acquired_error();
+    moves->assign(objects.size(), false);
+    for (auto object : objects) {
+        if (object->m_acquired == acquire && error != CL_SUCCESS) {
+            return error;
+        }
+    }
+    for (size_t i = 0; i < objects.size(); i++) {
+        (*moves)[i] = objects[i]->m_acquired != acquire;
+        objects[i]->m_acquired = acquire;
+    }
+    return CL_SUCCESS;
+}
+
+void cvk_interop_device::unmark(const std::vector<cvk_interop_object*>& objects,
+                                const std::vector<bool>& moves, bool acquired) {
+    std::lock_guard<std::mutex> lock(m_lock);
+    for (size_t i = 0; i < objects.size(); i++) {
+        if (moves[i]) {
+            objects[i]->m_acquired = acquired;
+        }
+    }
+}
+
+void cvk_interop_device::report_user_event_wait() {
+    std::lock_guard<std::mutex> lock(m_lock);
+    if (!m_reported_user_event) {
+        m_reported_user_event = true;
+        cvk_warn("A release waits for an incomplete user event before it "
+                 "returns; it does not return until that event completes.");
+    }
+}
